# Site-specific values for this project. Copy to config/local.env (gitignored) and fill in.
# Tracked files use the placeholders shown in the comments; local/ keeps the owner's working
# copies with the real values (see serving/README.md). Never put keys or tokens here:
# secrets stay in ${QWEN36_SECRETS_DIR} and are referenced by path only.

# This repository (Linux view and Windows view)
QWEN36_WORKSPACE=/path/to/qwen36-moe-16gb            # placeholder: /path/to/qwen36-moe-16gb
QWEN36_WORKSPACE_WIN='C:\path\to\qwen36-moe-16gb'
# Previous workspace kept as the read-only archive (see ARCHIVE.md); placeholder /path/to/qwen36-workspace
QWEN36_ARCHIVE=/path/to/qwen36-workspace

# Linux (WSL2) runtime: installed release, venv, CUDA toolkit, reports, GPU lock
QWEN36_ROOT=/home/USER/qwen36-api                    # placeholder: /home/USER/qwen36-api
QWEN36_NATIVE=/home/USER/qwen36-api/optimization     # native experiment overlay ($N)
QWEN36_SECRETS_DIR=/home/USER/qwen36-api/secrets     # api.env lives here; never copied
QWEN36_MODEL_DIR=/path/to/LLM/qwen36-api/model       # pinned checkpoint; sync-v5 renders the model placeholder
QWEN36_WSL_DISTRO=archlinux
QWEN36_WSL_USER=USER

# Windows supervisor / management install
QWEN36_WIN_ROOT='C:\path\to\LLM\qwen36-api'          # placeholder: C:\path\to\LLM\qwen36-api

# Network edge (reverse proxy host reached over SSH; public HTTPS name)
QWEN36_PUBLIC_HOST=llm.example.com                    # placeholder: llm.example.com
QWEN36_FORGE_HOST=forge.example.com                   # placeholder: forge.example.com
QWEN36_EDGE_SSH_HOST=EDGE_SSH_HOST                    # ~/.ssh/config alias of the proxy host
QWEN36_BACKEND=127.0.0.1:1919                         # loopback API port tunnelled to the edge
