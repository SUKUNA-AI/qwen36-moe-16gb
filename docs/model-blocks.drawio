<mxfile host="tools/model-diagram.py"><diagram name="main128"><mxGraphModel dx="1180" dy="1010" grid="1" gridSize="10" page="1" pageWidth="1180" pageHeight="1010"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="layer" value="&lt;b&gt;× 40 слоёв декодера&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="370" height="560" as="geometry"/></mxCell><mxCell id="vram" value="&lt;b&gt;VRAM 16 ГБ  (RTX 5070 Ti)&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="460" y="60" width="330" height="360" as="geometry"/></mxCell><mxCell id="ram" value="&lt;b&gt;RAM хоста&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="460" y="560" width="330" height="224" as="geometry"/></mxCell><mxCell id="pre" value="&lt;b&gt;Prefill: два маршрута&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="840" y="60" width="320" height="440" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Обозначения&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;html=1;" vertex="1" parent="1"><mxGeometry x="840" y="560" width="320" height="224" as="geometry"/></mxCell><mxCell id="tok" value="&lt;b&gt;Токены запроса&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;chat-шаблон; prefix-кэш отрезает уже посчитанное&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#17202b;strokeColor=#17202b;fontColor=#ffffff;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="330" height="54" as="geometry"/></mxCell><mxCell id="emb" value="&lt;b&gt;Эмбеддинги  248 320 × 2048, BF16&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;таблица в pinned RAM, строки копируются на GPU побайтно&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="330" height="64" as="geometry"/></mxCell><mxCell id="norm1" value="&lt;b&gt;RMSNorm&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#9aa6b4;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="330" height="40" as="geometry"/></mxCell><mxCell id="gdn" value="&lt;b&gt;30 × GDN&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;линейное внимание; CUDA-ядра FLA (T2)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="158" height="84" as="geometry"/></mxCell><mxCell id="attn" value="&lt;b&gt;10 × attention&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;полное внимание, KV BF16&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#9aa6b4;html=1;" vertex="1" parent="1"><mxGeometry x="212" y="350" width="158" height="84" as="geometry"/></mxCell><mxCell id="norm2" value="&lt;b&gt;o-proj FP8 GEMV (S3) + residual → RMSNorm&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="454" width="330" height="40" as="geometry"/></mxCell><mxCell id="router" value="&lt;b&gt;Роутер: top-8 из 256 экспертов&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;bf16&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#9aa6b4;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="514" width="330" height="50" as="geometry"/></mxCell><mxCell id="lru" value="&lt;b&gt;Карта слотов (LRU)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;попадание → слот VRAM, промах → gather из RAM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#9aa6b4;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="584" width="330" height="50" as="geometry"/></mxCell><mxCell id="routed" value="&lt;b&gt;Routed GEMM NVFP4&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;decode: CUDA MoE (S3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="654" width="158" height="70" as="geometry"/></mxCell><mxCell id="shared" value="&lt;b&gt;Shared-эксперт&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;параллельно с gather (T3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="212" y="654" width="158" height="70" as="geometry"/></mxCell><mxCell id="epi" value="&lt;b&gt;Эпилог: routed + σ(gate)·shared — одно ядро (D5)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="744" width="330" height="40" as="geometry"/></mxCell><mxCell id="head" value="&lt;b&gt;Финальная норма → lm_head NVFP4&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#9aa6b4;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="830" width="330" height="54" as="geometry"/></mxCell><mxCell id="out" value="&lt;b&gt;Сэмплер → токен ответа&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;декод в CUDA-графе&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#17202b;strokeColor=#17202b;fontColor=#ffffff;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="910" width="330" height="54" as="geometry"/></mxCell><mxCell id="win" value="&lt;b&gt;Windows — ровно 1 ГиБ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#f1f3f6;strokeColor=#b5bfcb;html=1;" vertex="1" parent="1"><mxGeometry x="480" y="106" width="290" height="40" as="geometry"/></mxCell><mxCell id="w" value="&lt;b&gt;Плотные веса FP8 и attention  ≈ 1,8 ГиБ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#f1f3f6;strokeColor=#b5bfcb;html=1;" vertex="1" parent="1"><mxGeometry x="480" y="156" width="290" height="40" as="geometry"/></mxCell><mxCell id="kv" value="&lt;b&gt;KV-кэш BF16 + пул GDN  ≈ 3 ГиБ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#f1f3f6;strokeColor=#b5bfcb;html=1;" vertex="1" parent="1"><mxGeometry x="480" y="206" width="290" height="40" as="geometry"/></mxCell><mxCell id="slots" value="&lt;b&gt;Слоты экспертов: 4603&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;≈ 7,6 ГиБ, «горячие» эксперты всех слоёв (f1: 3164)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#e5f3ea;strokeColor=#1d7a46;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="480" y="256" width="290" height="64" as="geometry"/></mxCell><mxCell id="buf" value="&lt;b&gt;Двойной буфер слоя для prefill&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;сюда приходит банк следующего слоя&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#f1f3f6;strokeColor=#b5bfcb;html=1;" vertex="1" parent="1"><mxGeometry x="480" y="330" width="290" height="64" as="geometry"/></mxCell><mxCell id="banks" value="&lt;b&gt;Банки экспертов NVFP4  18,25 ГБ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;все 256 × 40, закреплённая память&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#f1f3f6;strokeColor=#b5bfcb;html=1;" vertex="1" parent="1"><mxGeometry x="480" y="606" width="290" height="64" as="geometry"/></mxCell><mxCell id="embh" value="&lt;b&gt;Таблица эмбеддингов  0,95 ГиБ&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#f1f3f6;strokeColor=#b5bfcb;html=1;" vertex="1" parent="1"><mxGeometry x="480" y="690" width="290" height="40" as="geometry"/></mxCell><mxCell id="pcie" value="&lt;b&gt;PCIe  ~41–49 ГБ/с&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;copy engine и TMA-gather&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#fff5e0;strokeColor=#b7791f;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="520" y="452" width="210" height="64" as="geometry"/></mxCell><mxCell id="short" value="&lt;b&gt;Короткий кусок  &lt; 2049 новых токенов&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;резидентные эксперты — D2D внутри GPU (T1); &lt; 160 токенов — только выбранные роутером (C1)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="860" y="106" width="280" height="118" as="geometry"/></mxCell><mxCell id="long" value="&lt;b&gt;Длинный документ  ≥ 2049&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;layer-major: банк слоя целиком в двойной буфер, копия идёт внахлёст с GEMM (C0)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="860" y="244" width="280" height="118" as="geometry"/></mxCell><mxCell id="dec" value="&lt;b&gt;Decode&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;промахи: TMA-gather в графе, спрятан за shared-экспертом (T3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="860" y="382" width="280" height="98" as="geometry"/></mxCell><mxCell id="lg1" value="&lt;b&gt;рычаг этого релиза&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="860" y="606" width="280" height="40" as="geometry"/></mxCell><mxCell id="lg2" value="&lt;b&gt;без изменений&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#9aa6b4;html=1;" vertex="1" parent="1"><mxGeometry x="860" y="656" width="280" height="40" as="geometry"/></mxCell><mxCell id="lg3" value="&lt;b&gt;память, которую мы отдали модели&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;fillColor=#e5f3ea;strokeColor=#1d7a46;strokeWidth=2;html=1;" vertex="1" parent="1"><mxGeometry x="860" y="706" width="280" height="40" as="geometry"/></mxCell><mxCell id="e0" style="endArrow=block;html=1;strokeColor=#9aa6b4;" edge="1" parent="1" source="tok" target="emb"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" style="endArrow=block;html=1;strokeColor=#9aa6b4;" edge="1" parent="1" source="emb" target="norm1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="endArrow=block;html=1;strokeColor=#9aa6b4;" edge="1" parent="1" source="norm1" target="gdn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="endArrow=block;html=1;strokeColor=#9aa6b4;" edge="1" parent="1" source="norm1" target="attn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="endArrow=block;html=1;strokeColor=#9aa6b4;" edge="1" parent="1" source="gdn" target="norm2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="endArrow=block;html=1;strokeColor=#9aa6b4;" edge="1" parent="1" source="attn" target="norm2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="endArrow=block;html=1;strokeColor=#9aa6b4;" edge="1" parent="1" source="norm2" target="router"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="endArrow=block;html=1;strokeColor=#9aa6b4;" edge="1" parent="1" source="router" target="lru"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" style="endArrow=block;html=1;strokeColor=#9aa6b4;" edge="1" parent="1" source="lru" target="routed"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" style="endArrow=block;html=1;strokeColor=#9aa6b4;" edge="1" parent="1" source="lru" target="shared"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" style="endArrow=block;html=1;strokeColor=#9aa6b4;" edge="1" parent="1" source="routed" target="epi"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" style="endArrow=block;html=1;strokeColor=#9aa6b4;" edge="1" parent="1" source="shared" target="epi"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" style="endArrow=block;html=1;strokeColor=#9aa6b4;" edge="1" parent="1" source="epi" target="head"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" style="endArrow=block;html=1;strokeColor=#9aa6b4;" edge="1" parent="1" source="head" target="out"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l0" value="попадания" style="endArrow=block;dashed=1;html=1;strokeColor=#b7791f;fontColor=#b7791f;" edge="1" parent="1" source="slots" target="lru"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l1" value="" style="endArrow=block;dashed=1;html=1;strokeColor=#b7791f;fontColor=#b7791f;" edge="1" parent="1" source="banks" target="pcie"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l2" value="prefill" style="endArrow=block;dashed=1;html=1;strokeColor=#b7791f;fontColor=#b7791f;" edge="1" parent="1" source="pcie" target="buf"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l3" value="промахи" style="endArrow=block;dashed=1;html=1;strokeColor=#b7791f;fontColor=#b7791f;" edge="1" parent="1" source="pcie" target="slots"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="l4" value="" style="endArrow=block;dashed=1;html=1;strokeColor=#b7791f;fontColor=#b7791f;" edge="1" parent="1" source="embh" target="emb"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
