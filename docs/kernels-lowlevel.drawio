 style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#e1f3e8;strokeColor=#1d7a46;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="920" y="120" width="16" height="26" as="geometry"/></mxCell><mxCell id="oproj-c55" value="" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#fdebd0;strokeColor=#b7791f;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="937" y="120" width="16" height="26" as="geometry"/></mxCell><mxCell id="oproj-c56" value="" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#dcebfa;strokeColor=#2b6cb0;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="954" y="120" width="16" height="26" as="geometry"/></mxCell><mxCell id="oproj-c57" value="" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#e1f3e8;strokeColor=#1d7a46;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="971" y="120" width="16" height="26" as="geometry"/></mxCell><mxCell id="oproj-c58" value="" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#fdebd0;strokeColor=#b7791f;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="988" y="120" width="16" height="26" as="geometry"/></mxCell><mxCell id="oproj-c59" value="" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#dcebfa;strokeColor=#2b6cb0;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="1005" y="120" width="16" height="26" as="geometry"/></mxCell><mxCell id="oproj-c60" value="" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#e1f3e8;strokeColor=#1d7a46;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="1022" y="120" width="16" height="26" as="geometry"/></mxCell><mxCell id="oproj-c61" value="" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#fdebd0;strokeColor=#b7791f;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="1039" y="120" width="16" height="26" as="geometry"/></mxCell><mxCell id="oproj-c62" value="" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#dcebfa;strokeColor=#2b6cb0;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="1056" y="120" width="16" height="26" as="geometry"/></mxCell><mxCell id="oproj-c63" value="" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#e1f3e8;strokeColor=#1d7a46;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="1073" y="120" width="16" height="26" as="geometry"/></mxCell><mxCell id="oproj-c64" value="" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#fdebd0;strokeColor=#b7791f;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="1090" y="120" width="16" height="26" as="geometry"/></mxCell><mxCell id="oproj-c65" value="" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#dcebfa;strokeColor=#2b6cb0;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="1107" y="120" width="16" height="26" as="geometry"/></mxCell><mxCell id="oproj-t66" value="0" style="text;fontSize=10;align=center;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="24.0" y="150" width="40" height="18" as="geometry"/></mxCell><mxCell id="oproj-t67" value="1" style="text;fontSize=10;align=center;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="41.0" y="150" width="40" height="18" as="geometry"/></mxCell><mxCell id="oproj-t68" value="2" style="text;fontSize=10;align=center;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="58.0" y="150" width="40" height="18" as="geometry"/></mxCell><mxCell id="oproj-t69" value="3" style="text;fontSize=10;align=center;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="75.0" y="150" width="40" height="18" as="geometry"/></mxCell><mxCell id="oproj-t70" value="4" style="text;fontSize=10;align=center;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="92.0" y="150" width="40" height="18" as="geometry"/></mxCell><mxCell id="oproj-t71" value="5" style="text;fontSize=10;align=center;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="109.0" y="150" width="40" height="18" as="geometry"/></mxCell><mxCell id="oproj-t72" value="62" style="text;fontSize=10;align=center;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="1078.0" y="150" width="40" height="18" as="geometry"/></mxCell><mxCell id="oproj-t73" value="63" style="text;fontSize=10;align=center;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="1095.0" y="150" width="40" height="18" as="geometry"/></mxCell><mxCell id="oproj-t74" value="…" style="text;fontSize=11;align=center;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="577.0" y="149" width="40" height="19" as="geometry"/></mxCell><mxCell id="oproj-c75" value="" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#dcebfa;strokeColor=#2b6cb0;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="178" width="16" height="16" as="geometry"/></mxCell><mxCell id="oproj-t76" value="сплит 0: тайлы 0, 3, …, 63 (22 тайла)" style="text;fontSize=12;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="60" y="177" width="228" height="20" as="geometry"/></mxCell><mxCell id="oproj-c77" value="" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#e1f3e8;strokeColor=#1d7a46;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="360" y="178" width="16" height="16" as="geometry"/></mxCell><mxCell id="oproj-t78" value="сплит 1: тайлы 1, 4, …, 61 (21)" style="text;fontSize=12;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="384" y="177" width="190" height="20" as="geometry"/></mxCell><mxCell id="oproj-c79" value="" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#fdebd0;strokeColor=#b7791f;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="660" y="178" width="16" height="16" as="geometry"/></mxCell><mxCell id="oproj-t80" value="сплит 2: тайлы 2, 5, …, 62 (21)" style="text;fontSize=12;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="684" y="177" width="190" height="20" as="geometry"/></mxCell><mxCell id="oproj-t81" value="не непрерывные куски" style="text;fontSize=12;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fontColor=#b3402f;html=1;" vertex="1" parent="1"><mxGeometry x="940" y="177" width="157" height="20" as="geometry"/></mxCell><mxCell id="oproj-b83" value="&lt;b&gt;1. memset 384 Б&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;семафоры split-K&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fbe9e7;strokeColor=#b3402f;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="262" width="534" height="44" as="geometry"/></mxCell><mxCell id="oproj-b84" value="&lt;b&gt;2. ядро xmma e4m3 → bf16, плитка 32×64×64&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;сетка (1, 32, 3) = 96 CTA × 128 потоков: 32 блока по выходам (2048 / 32 = 64 выхода на блок) × 3 сплита K&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fbe9e7;strokeColor=#b3402f;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="316" width="534" height="62" as="geometry"/></mxCell><mxCell id="oproj-b85" value="&lt;b&gt;сплит 0&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;тайлы 0, 3, 6, …&lt;br&gt;цепочка QMMA k32: 2 штуки на тайл, от +0 → p0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#dcebfa;strokeColor=#2b6cb0;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="400" width="174" height="112" as="geometry"/></mxCell><mxCell id="oproj-b88" value="&lt;b&gt;сплит 1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;тайлы 1, 4, 7, …&lt;br&gt;цепочка QMMA k32: 2 штуки на тайл, от +0 → p1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e1f3e8;strokeColor=#1d7a46;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="216" y="400" width="174" height="112" as="geometry"/></mxCell><mxCell id="oproj-b91" value="&lt;b&gt;сплит 2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;тайлы 2, 5, 8, …&lt;br&gt;цепочка QMMA k32: 2 штуки на тайл, от +0 → p2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fdebd0;strokeColor=#b7791f;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="396" y="400" width="174" height="112" as="geometry"/></mxCell><mxCell id="oproj-b94" value="&lt;b&gt;3. редукция внутри ядра, по очереди&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ожидание LDG.STRONG → семафор ATOMG.ADD → последовательные FADD; порядок (p0 + p2) + p1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fbe9e7;strokeColor=#b3402f;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="540" width="534" height="74" as="geometry"/></mxCell><mxCell id="oproj-b95" value="&lt;b&gt;4. эпилог&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;alpha = sa·sb; FFMA(acc, alpha, 0); BF16 с округлением к чётному&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fbe9e7;strokeColor=#b3402f;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="624" width="534" height="46" as="geometry"/></mxCell><mxCell id="oproj-b96" value="&lt;b&gt;Что показал замер&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Nsight Compute (f1, частоты зафиксированы на базовых): 16.3 мкс, DRAM 59.6 %, SM 21 %, заполнение 11 %, 74 регистра на поток. На CUDA-графе вместе с memset: 17.4 мкс.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="684" width="534" height="96" as="geometry"/></mxCell><mxCell id="oproj-b98" value="&lt;b&gt;Сетка: полоса = 16 строк весов&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;128 полос (2048 / 16). M = 1…3: 128 CTA × 96 потоков; M = 4…8: 64 CTA × 192 потока, по две полосы в CTA&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="611" y="262" width="533" height="62" as="geometry"/></mxCell><mxCell id="oproj-b100" value="&lt;b&gt;Веса W (VRAM)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;на тайл 16 строк × 64 Б&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e5f3ea;strokeColor=#1d7a46;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="623" y="366" width="113" height="96" as="geometry"/></mxCell><mxCell id="oproj-b101" value="&lt;b&gt;Кольца cp.async&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;3 кольца, по одному на варп: 12 стадий (M ≤ 3) или 8 (M ≥ 4) × 1 КиБ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="754" y="366" width="113" height="96" as="geometry"/></mxCell><mxCell id="oproj-b102" value="&lt;b&gt;Активация X&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;M × (K+64) Б в shared, переставлена под фрагменты MMA&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="885" y="366" width="113" height="96" as="geometry"/></mxCell><mxCell id="oproj-b103" value="&lt;b&gt;Частичные p1, p2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;в shared; их пишут варпы 1 и 2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="1016" y="366" width="113" height="96" as="geometry"/></mxCell><mxCell id="oproj-b105" value="&lt;b&gt;варп 0 (z = 0)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;тайлы 0, 3, …: ldmatrix + 2 × QMMA k32; acc = строки n0…n0+7 и n0+8…n0+15&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#dcebfa;strokeColor=#2b6cb0;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="623" y="476" width="160" height="84" as="geometry"/></mxCell><mxCell id="oproj-b106" value="&lt;b&gt;варп 1 (z = 1)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;тайлы 1, 4, …: ldmatrix + 2 × QMMA k32; acc = строки n0…n0+7 и n0+8…n0+15&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e1f3e8;strokeColor=#1d7a46;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="797" y="476" width="160" height="84" as="geometry"/></mxCell><mxCell id="oproj-b107" value="&lt;b&gt;варп 2 (z = 2)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;тайлы 2, 5, …: ldmatrix + 2 × QMMA k32; acc = строки n0…n0+7 и n0+8…n0+15&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fdebd0;strokeColor=#b7791f;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="971" y="476" width="160" height="84" as="geometry"/></mxCell><mxCell id="oproj-b111" value="&lt;b&gt;Варп 0 после __syncthreads&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;out = BF16(FFMA((p0 + p2) + p1, sa·sb, 0)) → Y[m, n0…n0+15]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="611" y="604" width="533" height="50" as="geometry"/></mxCell><mxCell id="oproj-b112" value="&lt;b&gt;Результат&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;нет memset, семафора и рабочего буфера. Микробенч на графе, M = 1: 17.4 → 12.1–12.5 мкс на проекцию (≈ 0.2 мс на шаг). Ядро читает 8 МиБ весов ≈ 690 ГБ/с. Арифметика совпадает с cuBLASLt бит в бит.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e5f3ea;strokeColor=#1d7a46;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="611" y="668" width="533" height="112" as="geometry"/></mxCell><mxCell id="oproj-b114" value="&lt;b&gt;Выведено пробами&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;probe_splitk.py: слагаемые ±448·448 и 2⁻¹⁸ показывают, какие тайлы делят цепочку и в каком порядке складываются&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="838" width="208" height="94" as="geometry"/></mxCell><mxCell id="oproj-b115" value="&lt;b&gt;Загрузка&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;библиотека из запечатанного memfd только при совпадении sha256 и ABI&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="260" y="838" width="208" height="94" as="geometry"/></mxCell><mxCell id="oproj-b116" value="&lt;b&gt;Самопроверка&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;M = 1…8: коды, гауссовы, граничные, −0, масштабы; побитово с torch._scaled_mm&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="484" y="838" width="208" height="94" as="geometry"/></mxCell><mxCell id="oproj-b117" value="&lt;b&gt;Проверка весов&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;реальные веса каждого слоя, для каждого включённого M&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="708" y="838" width="208" height="94" as="geometry"/></mxCell><mxCell id="oproj-b118" value="&lt;b&gt;Несовпадение&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;этот M остаётся на cuBLASLt, событие пишется в лог&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fbe9e7;strokeColor=#b3402f;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="932" y="838" width="208" height="94" as="geometry"/></mxCell><mxCell id="oproj-a86" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.2;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="123" y="378" as="sourcePoint"/><mxPoint x="123" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="oproj-a87" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.4;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="123" y="512" as="sourcePoint"/><mxPoint x="123" y="540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="oproj-a89" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.2;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="303" y="378" as="sourcePoint"/><mxPoint x="303" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="oproj-a90" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.4;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="303" y="512" as="sourcePoint"/><mxPoint x="303" y="540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="oproj-a92" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.2;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="483" y="378" as="sourcePoint"/><mxPoint x="483" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="oproj-a93" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.4;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="483" y="512" as="sourcePoint"/><mxPoint x="483" y="540" as="targetPoint"/></mxGeometry></mxCell><mxCell id="oproj-a104" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#b7791f;strokeWidth=1.7;dashed=1;fontSize=10;fontColor=#b7791f;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="736" y="414" as="sourcePoint"/><mxPoint x="754" y="414" as="targetPoint"/></mxGeometry></mxCell><mxCell id="oproj-a108" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.4;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="703" y="560" as="sourcePoint"/><mxPoint x="703" y="604" as="targetPoint"/></mxGeometry></mxCell><mxCell id="oproj-a109" value="p1" style="endArrow=block;html=1;rounded=0;strokeColor=#6b46c1;strokeWidth=1.4;dashed=1;dashPattern=2 4;fontSize=10;fontColor=#6b46c1;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="877" y="560" as="sourcePoint"/><mxPoint x="877" y="604" as="targetPoint"/></mxGeometry></mxCell><mxCell id="oproj-a110" value="p2" style="endArrow=block;html=1;rounded=0;strokeColor=#6b46c1;strokeWidth=1.4;dashed=1;dashPattern=2 4;fontSize=10;fontColor=#6b46c1;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1051" y="560" as="sourcePoint"/><mxPoint x="1051" y="604" as="targetPoint"/></mxGeometry></mxCell><mxCell id="oproj-a119" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="244" y="885" as="sourcePoint"/><mxPoint x="260" y="885" as="targetPoint"/></mxGeometry></mxCell><mxCell id="oproj-a120" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="468" y="885" as="sourcePoint"/><mxPoint x="484" y="885" as="targetPoint"/></mxGeometry></mxCell><mxCell id="oproj-a121" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="692" y="885" as="sourcePoint"/><mxPoint x="708" y="885" as="targetPoint"/></mxGeometry></mxCell><mxCell id="oproj-a122" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="916" y="885" as="sourcePoint"/><mxPoint x="932" y="885" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="moe-decode" name="MoE decode: GEMV по NVFP4-экспертам, раскладка по блокам и потокам"><mxGraphModel dx="1180" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1180" pageHeight="1000" background="#f6f7f9"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="moe-decode-title" value="&lt;b&gt;MoE decode: GEMV по NVFP4-экспертам, раскладка по блокам и потокам&lt;/b&gt;" style="text;fontSize=18;align=left;verticalAlign=middle;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1140" height="30" as="geometry"/></mxCell><mxCell id="moe-decode-sub" value="Те же операции и тот же порядок накопления, что у Triton-ядра; меняется только перемещение данных. Показан M = 1 (один токен, 8 экспертов), вариант ядра для M ≤ 2: 128 потоков, по 2 строки на команду." style="text;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1140" height="34" as="geometry"/></mxCell><mxCell id="moe-decode-g1" value="&lt;b&gt;Routed-часть MoE-блока на шаге decode&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="1140" height="154" as="geometry"/></mxCell><mxCell id="moe-decode-g15" value="&lt;b&gt;Строка весов: куски по 16 байт и четыре потока команды&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="258" width="560" height="372" as="geometry"/></mxCell><mxCell id="moe-decode-g53" value="&lt;b&gt;Что делает поток r с куском c (порядок как у Triton)&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="600" y="258" width="560" height="372" as="geometry"/></mxCell><mxCell id="moe-decode-g60" value="&lt;b&gt;Редукция 16 частичных сумм: то же дерево, что у Triton, через shfl.xor&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="644" width="1140" height="338" as="geometry"/></mxCell><mxCell id="moe-decode-b2" value="&lt;b&gt;Вход x&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;bf16 [2048]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="124" width="124" height="64" as="geometry"/></mxCell><mxCell id="moe-decode-b3" value="&lt;b&gt;gate_up GEMV&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;N = 1024, K = 2048; сетка (8, 16) × 128 потоков&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="190" y="124" width="230" height="64" as="geometry"/></mxCell><mxCell id="moe-decode-b4" value="&lt;b&gt;SiLU·mul&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Triton, без изменений; [8 × 1024] → [8 × 512]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="444" y="124" width="150" height="64" as="geometry"/></mxCell><mxCell id="moe-decode-b5" value="&lt;b&gt;down GEMV&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;N = 2048, K = 512, × вес роутера; сетка (8, 32) × 128 потоков&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="618" y="124" width="250" height="64" as="geometry"/></mxCell><mxCell id="moe-decode-b6" value="&lt;b&gt;Σ по top-8&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Triton, без изменений; [8 × 2048] → [2048]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="892" y="124" width="150" height="64" as="geometry"/></mxCell><mxCell id="moe-decode-b7" value="&lt;b&gt;Выход&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;bf16&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="1066" y="124" width="78" height="64" as="geometry"/></mxCell><mxCell id="moe-decode-t13" value="Сетка: blockIdx.x = маршрут (токен × 8 + k), blockIdx.y = полоса из 64 выходов; слот эксперта берётся из topk_ids (его проставил ensure_experts). Для M ≥ 3 полоса 128 выходов: сетки (M" style="text;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="196.0" width="1113" height="19.5" as="geometry"/></mxCell><mxCell id="moe-decode-t14" value="× 8, 8) и (M × 8, 16)." style="text;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="211.5" width="121" height="19.5" as="geometry"/></mxCell><mxCell id="moe-decode-c16" value="0" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#dcebfa;strokeColor=#2b6cb0;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="292" width="30" height="30" as="geometry"/></mxCell><mxCell id="moe-decode-c17" value="1" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#e1f3e8;strokeColor=#1d7a46;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="67" y="292" width="30" height="30" as="geometry"/></mxCell><mxCell id="moe-decode-c18" value="2" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#fdebd0;strokeColor=#b7791f;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="98" y="292" width="30" height="30" as="geometry"/></mxCell><mxCell id="moe-decode-c19" value="3" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#efe3f7;strokeColor=#7b3fa0;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="129" y="292" width="30" height="30" as="geometry"/></mxCell><mxCell id="moe-decode-c20" value="4" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#dcebfa;strokeColor=#2b6cb0;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="160" y="292" width="30" height="30" as="geometry"/></mxCell><mxCell id="moe-decode-c21" value="5" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#e1f3e8;strokeColor=#1d7a46;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="191" y="292" width="30" height="30" as="geometry"/></mxCell><mxCell id="moe-decode-c22" value="6" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#fdebd0;strokeColor=#b7791f;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="222" y="292" width="30" height="30" as="geometry"/></mxCell><mxCell id="moe-decode-c23" value="7" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#efe3f7;strokeColor=#7b3fa0;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="253" y="292" width="30" height="30" as="geometry"/></mxCell><mxCell id="moe-decode-c24" value="8" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#dcebfa;strokeColor=#2b6cb0;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="284" y="292" width="30" height="30" as="geometry"/></mxCell><mxCell id="moe-decode-c25" value="9" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#e1f3e8;strokeColor=#1d7a46;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="315" y="292" width="30" height="30" as="geometry"/></mxCell><mxCell id="moe-decode-c26" value="10" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#fdebd0;strokeColor=#b7791f;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="346" y="292" width="30" height="30" as="geometry"/></mxCell><mxCell id="moe-decode-c27" value="11" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#efe3f7;strokeColor=#7b3fa0;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="377" y="292" width="30" height="30" as="geometry"/></mxCell><mxCell id="moe-decode-c28" value="12" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#dcebfa;strokeColor=#2b6cb0;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="408" y="292" width="30" height="30" as="geometry"/></mxCell><mxCell id="moe-decode-c29" value="13" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#e1f3e8;strokeColor=#1d7a46;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="439" y="292" width="30" height="30" as="geometry"/></mxCell><mxCell id="moe-decode-c30" value="14" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#fdebd0;strokeColor=#b7791f;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="470" y="292" width="30" height="30" as="geometry"/></mxCell><mxCell id="moe-decode-c31" value="15" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#efe3f7;strokeColor=#7b3fa0;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="501" y="292" width="30" height="30" as="geometry"/></mxCell><mxCell id="moe-decode-t32" value="… 63" style="text;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="534" y="299" width="40" height="19" as="geometry"/></mxCell><mxCell id="moe-decode-t34" value="it = 0" style="text;fontSize=10;align=center;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="78.0" y="333.5" width="40" height="18.5" as="geometry"/></mxCell><mxCell id="moe-decode-t36" value="it = 1" style="text;fontSize=10;align=center;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="202.0" y="333.5" width="40" height="18.5" as="geometry"/></mxCell><mxCell id="moe-decode-t38" value="it = 2" style="text;fontSize=10;align=center;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="326.0" y="333.5" width="40" height="18.5" as="geometry"/></mxCell><mxCell id="moe-decode-t40" value="it = 3" style="text;fontSize=10;align=center;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="450.0" y="333.5" width="40" height="18.5" as="geometry"/></mxCell><mxCell id="moe-decode-t41" value="it = 15" style="text;fontSize=10;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="534" y="333.5" width="43" height="18.5" as="geometry"/></mxCell><mxCell id="moe-decode-c42" value="" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#dcebfa;strokeColor=#2b6cb0;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="360" width="14" height="14" as="geometry"/></mxCell><mxCell id="moe-decode-t43" value="r0: c = 4·it + 0" style="text;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="56" y="359" width="87" height="19" as="geometry"/></mxCell><mxCell id="moe-decode-c44" value="" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#e1f3e8;strokeColor=#1d7a46;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="162" y="360" width="14" height="14" as="geometry"/></mxCell><mxCell id="moe-decode-t45" value="r1: c = 4·it + 1" style="text;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="182" y="359" width="87" height="19" as="geometry"/></mxCell><mxCell id="moe-decode-c46" value="" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#fdebd0;strokeColor=#b7791f;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="288" y="360" width="14" height="14" as="geometry"/></mxCell><mxCell id="moe-decode-t47" value="r2: c = 4·it + 2" style="text;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="308" y="359" width="87" height="19" as="geometry"/></mxCell><mxCell id="moe-decode-c48" value="" style="rounded=1;whiteSpace=wrap;fontSize=10;fillColor=#efe3f7;strokeColor=#7b3fa0;strokeWidth=1.6;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="414" y="360" width="14" height="14" as="geometry"/></mxCell><mxCell id="moe-decode-t49" value="r3: c = 4·it + 3" style="text;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="434" y="359" width="87" height="19" as="geometry"/></mxCell><mxCell id="moe-decode-b50" value="&lt;b&gt;Кусок c = 16 Б весов + 2 Б масштабов&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;32 кода e2m1 (4 слова по 8) = K от 32c до 32c + 31; 2 масштаба e4m3 на блоки по 16 значений&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="388" width="252" height="108" as="geometry"/></mxCell><mxCell id="moe-decode-b51" value="&lt;b&gt;Кольцо предвыборки в регистрах&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PF = 2 куска в полёте на поток: ld.global.nc.v4 (16 Б) и ld u16 для масштабов, без выделения в L1; веса запрашиваются раньше, чем активация попадает в shared&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="298" y="388" width="270" height="108" as="geometry"/></mxCell><mxCell id="moe-decode-b52" value="&lt;b&gt;CTA: 128 потоков = 32 команды × 4 потока&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;команда t считает строки n0 + t и n0 + t + 32 (2 строки на команду); поток r команды берёт куски c = 4·it + r. Активация bf16 → fp32 кладётся в shared один раз на CTA (K × 4 Б = 8 КиБ при K = 2048).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="508" width="532" height="110" as="geometry"/></mxCell><mxCell id="moe-decode-b54" value="&lt;b&gt;1. Слово w = 8 кодов e2m1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;cvt e2m1 → f16 → f32: точная таблица, код 8 = −0.0; активация a из shared (fp32)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="616" y="292" width="528" height="56" as="geometry"/></mxCell><mxCell id="moe-decode-b55" value="&lt;b&gt;2. Цепочка FFMA от +0&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;acc = 0; acc = fma(a[8w + j], код_j, acc), j = 0…7; произведения точны&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="616" y="358" width="528" height="56" as="geometry"/></mxCell><mxCell id="moe-decode-b56" value="&lt;b&gt;3. Частичная сумма&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;P[4r + q] = fma(acc, масштаб блока, P[4r + q]), q = 0…3: 16 частичных сумм P на строку&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="616" y="424" width="528" height="56" as="geometry"/></mxCell><mxCell id="moe-decode-b59" value="&lt;b&gt;Что было узким местом и что стало&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Triton-ядро в f1 (Nsight Compute, базовые частоты): сетка (8, 64, 1) × 128 потоков, 23.1 мкс, DRAM 48.6 %, заполнение 54 %, 40 регистров.&lt;br&gt;Микробенч на графе, M = 1: gate_up 18.5 → 12.5–12.9 мкс, down 9.4 → 7.4–7.8 мкс (~720 и ~600 ГБ/с).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="616" y="494" width="528" height="124" as="geometry"/></mxCell><mxCell id="moe-decode-b61" value="&lt;b&gt;поток r0&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;P[0] … P[3]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#dcebfa;strokeColor=#2b6cb0;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="678" width="150" height="44" as="geometry"/></mxCell><mxCell id="moe-decode-b62" value="&lt;b&gt;s0 = P[0] + P[1]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;s1 = P[2] + P[3]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=11;fillColor=#dcebfa;strokeColor=#2b6cb0;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="738" width="150" height="50" as="geometry"/></mxCell><mxCell id="moe-decode-b64" value="&lt;b&gt;поток r1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;P[4] … P[7]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e1f3e8;strokeColor=#1d7a46;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="196" y="678" width="150" height="44" as="geometry"/></mxCell><mxCell id="moe-decode-b65" value="&lt;b&gt;s2 = P[4] + P[5]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;s3 = P[6] + P[7]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=11;fillColor=#e1f3e8;strokeColor=#1d7a46;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="196" y="738" width="150" height="50" as="geometry"/></mxCell><mxCell id="moe-decode-b67" value="&lt;b&gt;поток r2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;P[8] … P[11]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fdebd0;strokeColor=#b7791f;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="356" y="678" width="150" height="44" as="geometry"/></mxCell><mxCell id="moe-decode-b68" value="&lt;b&gt;s4 = P[8] + P[9]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;s5 = P[10] + P[11]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=11;fillColor=#fdebd0;strokeColor=#b7791f;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="356" y="738" width="150" height="50" as="geometry"/></mxCell><mxCell id="moe-decode-b70" value="&lt;b&gt;поток r3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;P[12] … P[15]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#efe3f7;strokeColor=#7b3fa0;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="516" y="678" width="150" height="44" as="geometry"/></mxCell><mxCell id="moe-decode-b71" value="&lt;b&gt;s6 = P[12] + P[13]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;s7 = P[14] + P[15]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=11;fillColor=#efe3f7;strokeColor=#7b3fa0;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="516" y="738" width="150" height="50" as="geometry"/></mxCell><mxCell id="moe-decode-b73" value="&lt;b&gt;t0 = s0 + s4&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;t1 = s1 + s5&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=11;fillColor=#dcebfa;strokeColor=#2b6cb0;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="818" width="150" height="50" as="geometry"/></mxCell><mxCell id="moe-decode-b74" value="&lt;b&gt;t0 = s2 + s6&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;t1 = s3 + s7&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=11;fillColor=#e1f3e8;strokeColor=#1d7a46;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="196" y="818" width="150" height="50" as="geometry"/></mxCell><mxCell id="moe-decode-b79" value="&lt;b&gt;u0 = (s0+s4) + (s2+s6)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;u1 = (s1+s5) + (s3+s7)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=11;fillColor=#dcebfa;strokeColor=#2b6cb0;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="898" width="310" height="56" as="geometry"/></mxCell><mxCell id="moe-decode-b82" value="&lt;b&gt;v = u0 + u1, поток r0&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;out = bf16(v × global[слот, n]) (в down ещё × вес роутера) → c[токен, k, n]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=11;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="376" y="898" width="304" height="56" as="geometry"/></mxCell><mxCell id="moe-decode-t84" value="shfl.xor 2 складывает потоки r0 с r2 и r1 с r3, shfl.xor 1 — r0 с r1; итог" style="text;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="716" y="670.0" width="430" height="19.5" as="geometry"/></mxCell><mxCell id="moe-decode-t85" value="собирает поток r0. Каждое сложение, умножение и fma прописаны в" style="text;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="716" y="685.5" width="412" height="19.5" as="geometry"/></mxCell><mxCell id="moe-decode-t86" value="PTX с явным округлением (add.rn, mul.rn, fma.rn): ptxas не может ни" style="text;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="716" y="701.0" width="412" height="19.5" as="geometry"/></mxCell><mxCell id="moe-decode-t87" value="слить их, ни переставить. Произведение e2m1 × bf16 точно в fp32," style="text;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="716" y="716.6" width="393" height="19.5" as="geometry"/></mxCell><mxCell id="moe-decode-t88" value="поэтому цепочка FFMA равна FMUL + FADD бит в бит." style="text;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="716" y="732.1" width="322" height="19.5" as="geometry"/></mxCell><mxCell id="moe-decode-b89" value="&lt;b&gt;Проверка&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;4284 сравнения GEMM, 0 расхождений; самопроверка при загрузке (каждый код e2m1 и масштаб e4m3, M = 1…8, top_k 8) и проверка на реальных весах каждого слоя.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e5f3ea;strokeColor=#1d7a46;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="716" y="780" width="428" height="84" as="geometry"/></mxCell><mxCell id="moe-decode-b90" value="&lt;b&gt;При несовпадении&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;слой остаётся на Triton-ядре, событие пишется в лог; точность сохраняется, выигрыш пропадает.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fbe9e7;strokeColor=#b3402f;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="716" y="874" width="428" height="80" as="geometry"/></mxCell><mxCell id="moe-decode-a8" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="160" y="156" as="sourcePoint"/><mxPoint x="190" y="156" as="targetPoint"/></mxGeometry></mxCell><mxCell id="moe-decode-a9" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="420" y="156" as="sourcePoint"/><mxPoint x="444" y="156" as="targetPoint"/></mxGeometry></mxCell><mxCell id="moe-decode-a10" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="594" y="156" as="sourcePoint"/><mxPoint x="618" y="156" as="targetPoint"/></mxGeometry></mxCell><mxCell id="moe-decode-a11" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="868" y="156" as="sourcePoint"/><mxPoint x="892" y="156" as="targetPoint"/></mxGeometry></mxCell><mxCell id="moe-decode-a12" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1042" y="156" as="sourcePoint"/><mxPoint x="1066" y="156" as="targetPoint"/></mxGeometry></mxCell><mxCell id="moe-decode-a33" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.4;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="38" y="330" as="sourcePoint"/><mxPoint x="157" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="moe-decode-a35" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.4;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="162" y="330" as="sourcePoint"/><mxPoint x="281" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="moe-decode-a37" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.4;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="286" y="330" as="sourcePoint"/><mxPoint x="405" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="moe-decode-a39" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.4;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="330" as="sourcePoint"/><mxPoint x="529" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="moe-decode-a57" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.3;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="348" as="sourcePoint"/><mxPoint x="880" y="358" as="targetPoint"/></mxGeometry></mxCell><mxCell id="moe-decode-a58" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.3;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="414" as="sourcePoint"/><mxPoint x="880" y="424" as="targetPoint"/></mxGeometry></mxCell><mxCell id="moe-decode-a63" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.3;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="111" y="722" as="sourcePoint"/><mxPoint x="111" y="738" as="targetPoint"/></mxGeometry></mxCell><mxCell id="moe-decode-a66" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.3;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="271" y="722" as="sourcePoint"/><mxPoint x="271" y="738" as="targetPoint"/></mxGeometry></mxCell><mxCell id="moe-decode-a69" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.3;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="431" y="722" as="sourcePoint"/><mxPoint x="431" y="738" as="targetPoint"/></mxGeometry></mxCell><mxCell id="moe-decode-a72" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.3;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="591" y="722" as="sourcePoint"/><mxPoint x="591" y="738" as="targetPoint"/></mxGeometry></mxCell><mxCell id="moe-decode-a75" value="shfl.xor 2" style="endArrow=block;html=1;rounded=0;strokeColor=#6b46c1;strokeWidth=1.4;dashed=1;dashPattern=2 4;fontSize=10;fontColor=#6b46c1;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="111" y="788" as="sourcePoint"/><mxPoint x="111" y="818" as="targetPoint"/></mxGeometry></mxCell><mxCell id="moe-decode-a76" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#6b46c1;strokeWidth=1.3;dashed=1;dashPattern=2 4;fontSize=10;fontColor=#6b46c1;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="431" y="788" as="sourcePoint"/><mxPoint x="140" y="818" as="targetPoint"/><Array as="points"><mxPoint x="431" y="808"/><mxPoint x="140" y="808"/></Array></mxGeometry></mxCell><mxCell id="moe-decode-a77" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#6b46c1;strokeWidth=1.3;dashed=1;dashPattern=2 4;fontSize=10;fontColor=#6b46c1;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="591" y="788" as="sourcePoint"/><mxPoint x="260" y="818" as="targetPoint"/><Array as="points"><mxPoint x="591" y="800"/><mxPoint x="260" y="800"/></Array></mxGeometry></mxCell><mxCell id="moe-decode-a78" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#6b46c1;strokeWidth=1.3;dashed=1;dashPattern=2 4;fontSize=10;fontColor=#6b46c1;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="271" y="788" as="sourcePoint"/><mxPoint x="271" y="818" as="targetPoint"/></mxGeometry></mxCell><mxCell id="moe-decode-a80" value="shfl.xor 1" style="endArrow=block;html=1;rounded=0;strokeColor=#6b46c1;strokeWidth=1.4;dashed=1;dashPattern=2 4;fontSize=10;fontColor=#6b46c1;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="111" y="868" as="sourcePoint"/><mxPoint x="111" y="898" as="targetPoint"/></mxGeometry></mxCell><mxCell id="moe-decode-a81" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#6b46c1;strokeWidth=1.3;dashed=1;dashPattern=2 4;fontSize=10;fontColor=#6b46c1;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="271" y="868" as="sourcePoint"/><mxPoint x="200" y="898" as="targetPoint"/><Array as="points"><mxPoint x="271" y="878"/><mxPoint x="200" y="878"/></Array></mxGeometry></mxCell><mxCell id="moe-decode-a83" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="346" y="926" as="sourcePoint"/><mxPoint x="376" y="926" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="epilogue" name="Слитый эпилог MoE-блока: три мелких ядра → одно"><mxGraphModel dx="1180" dy="500" grid="1" gridSize="10" page="1" pageWidth="1180" pageHeight="500" background="#f6f7f9"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="epilogue-title" value="&lt;b&gt;Слитый эпилог MoE-блока: три мелких ядра → одно&lt;/b&gt;" style="text;fontSize=18;align=left;verticalAlign=middle;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1140" height="30" as="geometry"/></mxCell><mxCell id="epilogue-sub" value="out = routed + shared · σ(gate). Те же операции и те же округления, что у torch; fp-contraction выключен." style="text;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1140" height="34" as="geometry"/></mxCell><mxCell id="epilogue-g1" value="&lt;b&gt;Было: три bf16-ядра PyTorch, каждое читает и пишет [M, 2048] в память&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="78" width="1140" height="134" as="geometry"/></mxCell><mxCell id="epilogue-g9" value="&lt;b&gt;Стало: одно ядро Triton, 4 варпа; сетка (M, ⌈2048 / 1024⌉), при M = 1 это (1, 2)&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="226" width="1140" height="262" as="geometry"/></mxCell><mxCell id="epilogue-b2" value="&lt;b&gt;gate&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;линейка σ-гейта, bf16 [M, 1]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="112" width="156" height="80" as="geometry"/></mxCell><mxCell id="epilogue-b3" value="&lt;b&gt;ядро 1: torch.sigmoid&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;sig = bf16(σ(gate))&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fbe9e7;strokeColor=#b3402f;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="216" y="112" width="270" height="80" as="geometry"/></mxCell><mxCell id="epilogue-b4" value="&lt;b&gt;ядро 2: shared · sig&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;prod = bf16(shared × sig)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fbe9e7;strokeColor=#b3402f;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="510" y="112" width="300" height="80" as="geometry"/></mxCell><mxCell id="epilogue-b5" value="&lt;b&gt;ядро 3: routed + prod&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;out = bf16(routed + prod)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fbe9e7;strokeColor=#b3402f;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="834" y="112" width="310" height="80" as="geometry"/></mxCell><mxCell id="epilogue-b10" value="&lt;b&gt;Читает&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;gate (скаляр на строку), shared[h], routed[h]; всё bf16&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="260" width="200" height="76" as="geometry"/></mxCell><mxCell id="epilogue-b11" value="&lt;b&gt;sig = bf16(1 / (1 + exp(−gate)))&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;IEEE-деление div.rn, expf из libdevice&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=11;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="256" y="260" width="270" height="76" as="geometry"/></mxCell><mxCell id="epilogue-b12" value="&lt;b&gt;prod = bf16(shared × sig)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;одно умножение fp32, затем округление в bf16&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=11;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="546" y="260" width="270" height="76" as="geometry"/></mxCell><mxCell id="epilogue-b13" value="&lt;b&gt;out = bf16(routed + prod)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;одно сложение fp32, затем округление; запись [M, 2048]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=11;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="836" y="260" width="308" height="76" as="geometry"/></mxCell><mxCell id="epilogue-b17" value="&lt;b&gt;Почему enable_fp_fusion = False&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;С настройкой Triton по умолчанию умножение и сложение сливаются в один fma.rn.bf16: одно округление вместо двух, и результат расходится с torch. Здесь два округления остаются раздельными, как в трёх ядрах torch.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fbe9e7;strokeColor=#b3402f;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="352" width="560" height="120" as="geometry"/></mxCell><mxCell id="epilogue-b18" value="&lt;b&gt;Самопроверка до первого вызова&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;σ сверяется побитово с torch.sigmoid на всех 65 536 значениях bf16; затем случайные M = 1, 3, 8 и H = 2048, 1000 на трёх масштабах. Несовпадение, или вызов внутри захвата графа до проверки, оставляет путь torch.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e5f3ea;strokeColor=#1d7a46;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="616" y="352" width="528" height="120" as="geometry"/></mxCell><mxCell id="epilogue-a6" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="192" y="152" as="sourcePoint"/><mxPoint x="216" y="152" as="targetPoint"/></mxGeometry></mxCell><mxCell id="epilogue-a7" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="486" y="152" as="sourcePoint"/><mxPoint x="510" y="152" as="targetPoint"/></mxGeometry></mxCell><mxCell id="epilogue-a8" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="152" as="sourcePoint"/><mxPoint x="834" y="152" as="targetPoint"/></mxGeometry></mxCell><mxCell id="epilogue-a14" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="236" y="298" as="sourcePoint"/><mxPoint x="256" y="298" as="targetPoint"/></mxGeometry></mxCell><mxCell id="epilogue-a15" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="526" y="298" as="sourcePoint"/><mxPoint x="546" y="298" as="targetPoint"/></mxGeometry></mxCell><mxCell id="epilogue-a16" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="816" y="298" as="sourcePoint"/><mxPoint x="836" y="298" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="prefill-routes" name="Prefill: как эксперты слоя попадают в двойной буфер (три маршрута)"><mxGraphModel dx="1180" dy="920" grid="1" gridSize="10" page="1" pageWidth="1180" pageHeight="920" background="#f6f7f9"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="prefill-routes-title" value="&lt;b&gt;Prefill: как эксперты слоя попадают в двойной буфер (три маршрута)&lt;/b&gt;" style="text;fontSize=18;align=left;verticalAlign=middle;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1140" height="30" as="geometry"/></mxCell><mxCell id="prefill-routes-sub" value="Слой экспертов NVFP4 весит ≈ 456 МБ (256 экспертов). Двойной буфер занимает первые 2 × 256 слотов кэша экспертов; GEMM слоя L читает буфер L mod 2. Маршрут выбирает число некэшированных токенов запроса; цвет стрелок совпадает с цветом карточек ниже." style="text;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1140" height="34" as="geometry"/></mxCell><mxCell id="prefill-routes-g1" value="&lt;b&gt;RAM хоста (pinned)&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="300" height="316" as="geometry"/></mxCell><mxCell id="prefill-routes-g5" value="&lt;b&gt;VRAM: кэш слотов экспертов (4603 слота)&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="436" y="96" width="724" height="316" as="geometry"/></mxCell><mxCell id="prefill-routes-g24" value="&lt;b&gt;1. Короткий кусок, меньше 160 токенов: только выбранные роутером эксперты (раньше: слой целиком)&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#2b6cb0;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="428" width="1140" height="148" as="geometry"/></mxCell><mxCell id="prefill-routes-g32" value="&lt;b&gt;2. Чанк 160…2048 токенов: попадания копируются внутри GPU, промахи по PCIe (раньше: весь слой по PCIe)&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#1d7a46;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="586" width="1140" height="148" as="geometry"/></mxCell><mxCell id="prefill-routes-g40" value="&lt;b&gt;3. Длинный запрос, от 2049 токенов: послойный prefill (в исходном FreeToken слой копировался заново для каждого чанка)&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#b7791f;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="744" width="1140" height="148" as="geometry"/></mxCell><mxCell id="prefill-routes-b2" value="&lt;b&gt;Банки экспертов NVFP4&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;40 слоёв × 256 экспертов; слой ≈ 456 МБ, всего 18.25 ГБ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="134" width="268" height="110" as="geometry"/></mxCell><mxCell id="prefill-routes-b3" value="&lt;b&gt;Снимок карты слотов&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;[40, 256] int32 в pinned-памяти: один на чанк, нужен маршруту 2&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="262" width="268" height="120" as="geometry"/></mxCell><mxCell id="prefill-routes-b4" value="&lt;b&gt;PCIe 5.0 x16&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;≈ 41–49 ГБ/с&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fff5e0;strokeColor=#b7791f;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="338" y="134" width="78" height="248" as="geometry"/></mxCell><mxCell id="prefill-routes-b6" value="&lt;b&gt;Буфер 0&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;слоты 0…255: слои 0, 2, 4, …&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e5f3ea;strokeColor=#1d7a46;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="452" y="134" width="160" height="80" as="geometry"/></mxCell><mxCell id="prefill-routes-b7" value="&lt;b&gt;Буфер 1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;слоты 256…511: слои 1, 3, 5, …&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e5f3ea;strokeColor=#1d7a46;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="452" y="226" width="160" height="80" as="geometry"/></mxCell><mxCell id="prefill-routes-b8" value="&lt;b&gt;«Горячие» эксперты decode&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;слоты 512…4602: то, что осталось в кэше после decode; источник копий внутри GPU&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="648" y="134" width="250" height="172" as="geometry"/></mxCell><mxCell id="prefill-routes-b9" value="&lt;b&gt;Хвост слотов (layer-major)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;hidden + residual окна чанков: 8 КиБ на токен; слоты на это время размечаются как пустые&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="914" y="134" width="230" height="172" as="geometry"/></mxCell><mxCell id="prefill-routes-b10" value="&lt;b&gt;GEMM экспертов слоя L&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;читает буфер L mod 2; номер строки буфера = номер эксперта, поэтому ids роутера не переписываются&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="452" y="322" width="692" height="76" as="geometry"/></mxCell><mxCell id="prefill-routes-t22" value="D2D" style="text;fontSize=10;align=center;verticalAlign=middle;spacing=0;fontStyle=1;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="610.0" y="131.5" width="40" height="18.5" as="geometry"/></mxCell><mxCell id="prefill-routes-t23" value="D2D" style="text;fontSize=10;align=center;verticalAlign=middle;spacing=0;fontStyle=1;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="610.0" y="223.5" width="40" height="18.5" as="geometry"/></mxCell><mxCell id="prefill-routes-b25" value="&lt;b&gt;Роутер слоя L&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;выбранные эксперты известны только после роутера, поэтому копия начинается после него&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#dcebfa;strokeColor=#2b6cb0;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="464" width="262" height="100" as="geometry"/></mxCell><mxCell id="prefill-routes-b26" value="&lt;b&gt;Два небольших ядра&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;помечают выбранных и делят на попадания (слот ≥ 512) и промахи; списки остаются на устройстве&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#dcebfa;strokeColor=#2b6cb0;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="318" y="464" width="262" height="100" as="geometry"/></mxCell><mxCell id="prefill-routes-b27" value="&lt;b&gt;Попадания и промахи&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;попадания: fast_index_copy на потоке вычислений; промахи: TMA-gather (cp.async.bulk) на потоке копирования&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#dcebfa;strokeColor=#2b6cb0;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="600" y="464" width="262" height="100" as="geometry"/></mxCell><mxCell id="prefill-routes-b28" value="&lt;b&gt;GEMM после события ready&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;читает только выбранные строки буфера; байты остальных строк не читаются&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#dcebfa;strokeColor=#2b6cb0;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="882" y="464" width="262" height="100" as="geometry"/></mxCell><mxCell id="prefill-routes-b33" value="&lt;b&gt;Снимок карты слотов&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;в начале чанка, в pinned-память: одна синхронизация на чанк&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e1f3e8;strokeColor=#1d7a46;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="622" width="262" height="100" as="geometry"/></mxCell><mxCell id="prefill-routes-b34" value="&lt;b&gt;Старт слоя L: заказ слоя L+1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;по снимку хост делит экспертов на попадания (слот ≥ 512) и промахи&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e1f3e8;strokeColor=#1d7a46;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="318" y="622" width="262" height="100" as="geometry"/></mxCell><mxCell id="prefill-routes-b35" value="&lt;b&gt;Попадания и промахи&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;fast_index_copy (64 блока на банк) на потоке вычислений; отрезки подряд идущих экспертов — один cudaMemcpyBatchAsync&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e1f3e8;strokeColor=#1d7a46;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="600" y="622" width="262" height="100" as="geometry"/></mxCell><mxCell id="prefill-routes-b36" value="&lt;b&gt;События release и ready&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;release после GEMM освобождает буфер; ready разрешает GEMM следующего слоя&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e1f3e8;strokeColor=#1d7a46;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="882" y="622" width="262" height="100" as="geometry"/></mxCell><mxCell id="prefill-routes-b41" value="&lt;b&gt;Чанк 0 слоя L&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;заказывает копию слоя L+1 целиком в свободный буфер&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fdebd0;strokeColor=#b7791f;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="780" width="262" height="100" as="geometry"/></mxCell><mxCell id="prefill-routes-b42" value="&lt;b&gt;cudaMemcpyAsync по банкам&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;copy engine, один раз на запрос: на 120K 18 ГБ вместо 1076 ГБ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fdebd0;strokeColor=#b7791f;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="318" y="780" width="262" height="100" as="geometry"/></mxCell><mxCell id="prefill-routes-b43" value="&lt;b&gt;Все чанки слоя L&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;читают один буфер; hidden и residual окна лежат в хвосте слотов&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fdebd0;strokeColor=#b7791f;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="600" y="780" width="262" height="100" as="geometry"/></mxCell><mxCell id="prefill-routes-b44" value="&lt;b&gt;release после последнего чанка&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;копия слоя L+2 ждёт это событие; попаданий нет, горячие эксперты не используются&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fdebd0;strokeColor=#b7791f;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="882" y="780" width="262" height="100" as="geometry"/></mxCell><mxCell id="prefill-routes-a11" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#b7791f;strokeWidth=1.7;dashed=1;fontSize=10;fontColor=#b7791f;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="304" y="188" as="sourcePoint"/><mxPoint x="338" y="188" as="targetPoint"/></mxGeometry></mxCell><mxCell id="prefill-routes-a12" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#2b6cb0;strokeWidth=2.2;fontSize=10;fontColor=#2b6cb0;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="416" y="150" as="sourcePoint"/><mxPoint x="452" y="150" as="targetPoint"/></mxGeometry></mxCell><mxCell id="prefill-routes-a13" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#1d7a46;strokeWidth=2.2;fontSize=10;fontColor=#1d7a46;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="416" y="166" as="sourcePoint"/><mxPoint x="452" y="166" as="targetPoint"/></mxGeometry></mxCell><mxCell id="prefill-routes-a14" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#b7791f;strokeWidth=2.2;fontSize=10;fontColor=#b7791f;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="416" y="182" as="sourcePoint"/><mxPoint x="452" y="182" as="targetPoint"/></mxGeometry></mxCell><mxCell id="prefill-routes-a15" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#2b6cb0;strokeWidth=2.2;fontSize=10;fontColor=#2b6cb0;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="416" y="242" as="sourcePoint"/><mxPoint x="452" y="242" as="targetPoint"/></mxGeometry></mxCell><mxCell id="prefill-routes-a16" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#1d7a46;strokeWidth=2.2;fontSize=10;fontColor=#1d7a46;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="416" y="258" as="sourcePoint"/><mxPoint x="452" y="258" as="targetPoint"/></mxGeometry></mxCell><mxCell id="prefill-routes-a17" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#b7791f;strokeWidth=2.2;fontSize=10;fontColor=#b7791f;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="416" y="274" as="sourcePoint"/><mxPoint x="452" y="274" as="targetPoint"/></mxGeometry></mxCell><mxCell id="prefill-routes-a18" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#2b6cb0;strokeWidth=2.2;fontSize=10;fontColor=#2b6cb0;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="648" y="150" as="sourcePoint"/><mxPoint x="612" y="150" as="targetPoint"/></mxGeometry></mxCell><mxCell id="prefill-routes-a19" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#1d7a46;strokeWidth=2.2;fontSize=10;fontColor=#1d7a46;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="648" y="166" as="sourcePoint"/><mxPoint x="612" y="166" as="targetPoint"/></mxGeometry></mxCell><mxCell id="prefill-routes-a20" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#2b6cb0;strokeWidth=2.2;fontSize=10;fontColor=#2b6cb0;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="648" y="242" as="sourcePoint"/><mxPoint x="612" y="242" as="targetPoint"/></mxGeometry></mxCell><mxCell id="prefill-routes-a21" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#1d7a46;strokeWidth=2.2;fontSize=10;fontColor=#1d7a46;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="648" y="258" as="sourcePoint"/><mxPoint x="612" y="258" as="targetPoint"/></mxGeometry></mxCell><mxCell id="prefill-routes-a29" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="298" y="514" as="sourcePoint"/><mxPoint x="318" y="514" as="targetPoint"/></mxGeometry></mxCell><mxCell id="prefill-routes-a30" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="514" as="sourcePoint"/><mxPoint x="600" y="514" as="targetPoint"/></mxGeometry></mxCell><mxCell id="prefill-routes-a31" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="862" y="514" as="sourcePoint"/><mxPoint x="882" y="514" as="targetPoint"/></mxGeometry></mxCell><mxCell id="prefill-routes-a37" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="298" y="672" as="sourcePoint"/><mxPoint x="318" y="672" as="targetPoint"/></mxGeometry></mxCell><mxCell id="prefill-routes-a38" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="672" as="sourcePoint"/><mxPoint x="600" y="672" as="targetPoint"/></mxGeometry></mxCell><mxCell id="prefill-routes-a39" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="862" y="672" as="sourcePoint"/><mxPoint x="882" y="672" as="targetPoint"/></mxGeometry></mxCell><mxCell id="prefill-routes-a45" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="298" y="830" as="sourcePoint"/><mxPoint x="318" y="830" as="targetPoint"/></mxGeometry></mxCell><mxCell id="prefill-routes-a46" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="830" as="sourcePoint"/><mxPoint x="600" y="830" as="targetPoint"/></mxGeometry></mxCell><mxCell id="prefill-routes-a47" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="862" y="830" as="sourcePoint"/><mxPoint x="882" y="830" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="prefill-timeline" name="Копия слоя L+1 вместе с GEMM слоя L: что изменили приоритет потока и инвалидация раз за эпоху"><mxGraphModel dx="1180" dy="800" grid="1" gridSize="10" page="1" pageWidth="1180" pageHeight="800" background="#f6f7f9"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="prefill-timeline-title" value="&lt;b&gt;Копия слоя L+1 вместе с GEMM слоя L: что изменили приоритет потока и инвалидация раз за эпоху&lt;/b&gt;" style="text;fontSize=18;align=left;verticalAlign=middle;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1140" height="30" as="geometry"/></mxCell><mxCell id="prefill-timeline-sub" value="Двойной буфер: слой L+1 едет в буфер, который освободил слой L−1, пока считается слой L. Масштаб условный, показана механика. На коротком запросе копия слоя дольше счёта, поэтому задержка старта копии видна в TTFT." style="text;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1140" height="34" as="geometry"/></mxCell><mxCell id="prefill-timeline-g1" value="&lt;b&gt;Было: перед каждой копией на потоке копирования стоят 6 мелких ядер инвалидации&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="96" width="1140" height="244" as="geometry"/></mxCell><mxCell id="prefill-timeline-g23" value="&lt;b&gt;Стало: приоритет потока копирования, инвалидация буферов раз за эпоху на потоке вычислений&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="354" width="1140" height="244" as="geometry"/></mxCell><mxCell id="prefill-timeline-g45" value="&lt;b&gt;Что именно изменено и почему это работает&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="612" width="1140" height="176" as="geometry"/></mxCell><mxCell id="prefill-timeline-t2" value="поток" style="text;fontSize=12;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="34" y="160" width="46" height="20" as="geometry"/></mxCell><mxCell id="prefill-timeline-t3" value="вычислений" style="text;fontSize=12;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="34" y="176" width="86" height="20" as="geometry"/></mxCell><mxCell id="prefill-timeline-t4" value="поток" style="text;fontSize=12;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="34" y="258" width="46" height="20" as="geometry"/></mxCell><mxCell id="prefill-timeline-t5" value="копирования" style="text;fontSize=12;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="34" y="274" width="90" height="20" as="geometry"/></mxCell><mxCell id="prefill-timeline-b6" value="" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="140" y="142" width="1010" height="66" as="geometry"/></mxCell><mxCell id="prefill-timeline-b7" value="" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="140" y="240" width="1010" height="66" as="geometry"/></mxCell><mxCell id="prefill-timeline-b8" value="&lt;b&gt;GEMM L−1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="150" y="148" width="90" height="54" as="geometry"/></mxCell><mxCell id="prefill-timeline-b9" value="&lt;b&gt;GEMM L&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="240" y="148" width="90" height="54" as="geometry"/></mxCell><mxCell id="prefill-timeline-x10" value="ждёт ready: копия L+1 ещё не закончена" style="rounded=1;dashed=1;whiteSpace=wrap;fontSize=11;fillColor=none;strokeColor=#b3402f;fontColor=#b3402f;html=1;" vertex="1" parent="1"><mxGeometry x="330" y="148" width="190" height="54" as="geometry"/></mxCell><mxCell id="prefill-timeline-b11" value="&lt;b&gt;GEMM L+1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="520" y="148" width="90" height="54" as="geometry"/></mxCell><mxCell id="prefill-timeline-x12" value="ждёт ready" style="rounded=1;dashed=1;whiteSpace=wrap;fontSize=11;fillColor=none;strokeColor=#b3402f;fontColor=#b3402f;html=1;" vertex="1" parent="1"><mxGeometry x="610" y="148" width="190" height="54" as="geometry"/></mxCell><mxCell id="prefill-timeline-b13" value="&lt;b&gt;GEMM L+2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="800" y="148" width="90" height="54" as="geometry"/></mxCell><mxCell id="prefill-timeline-x14" value="6 ядер ждут SM" style="rounded=1;dashed=1;whiteSpace=wrap;fontSize=10;fillColor=none;strokeColor=#b3402f;fontColor=#b3402f;html=1;" vertex="1" parent="1"><mxGeometry x="240" y="246" width="90" height="54" as="geometry"/></mxCell><mxCell id="prefill-timeline-b15" value="&lt;b&gt;DMA слоя L+1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;≈ 456 МБ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fff5e0;strokeColor=#b7791f;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="330" y="246" width="190" height="54" as="geometry"/></mxCell><mxCell id="prefill-timeline-x16" value="6 ядер ждут SM" style="rounded=1;dashed=1;whiteSpace=wrap;fontSize=10;fillColor=none;strokeColor=#b3402f;fontColor=#b3402f;html=1;" vertex="1" parent="1"><mxGeometry x="520" y="246" width="90" height="54" as="geometry"/></mxCell><mxCell id="prefill-timeline-b17" value="&lt;b&gt;DMA слоя L+2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;≈ 456 МБ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fff5e0;strokeColor=#b7791f;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="610" y="246" width="190" height="54" as="geometry"/></mxCell><mxCell id="prefill-timeline-x18" value="6 ядер ждут SM" style="rounded=1;dashed=1;whiteSpace=wrap;fontSize=10;fillColor=none;strokeColor=#b3402f;fontColor=#b3402f;html=1;" vertex="1" parent="1"><mxGeometry x="800" y="246" width="90" height="54" as="geometry"/></mxCell><mxCell id="prefill-timeline-b19" value="&lt;b&gt;DMA слоя L+3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fff5e0;strokeColor=#b7791f;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="890" y="246" width="190" height="54" as="geometry"/></mxCell><mxCell id="prefill-timeline-t22" value="период слоя = счёт + копия" style="text;fontSize=12;align=right;verticalAlign=middle;spacing=0;fontStyle=1;fontColor=#b3402f;html=1;" vertex="1" parent="1"><mxGeometry x="960" y="314" width="186" height="20" as="geometry"/></mxCell><mxCell id="prefill-timeline-t24" value="поток" style="text;fontSize=12;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="34" y="418" width="46" height="20" as="geometry"/></mxCell><mxCell id="prefill-timeline-t25" value="вычислений" style="text;fontSize=12;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="34" y="434" width="86" height="20" as="geometry"/></mxCell><mxCell id="prefill-timeline-t26" value="поток" style="text;fontSize=12;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="34" y="516" width="46" height="20" as="geometry"/></mxCell><mxCell id="prefill-timeline-t27" value="копирования" style="text;fontSize=12;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="34" y="532" width="90" height="20" as="geometry"/></mxCell><mxCell id="prefill-timeline-b28" value="" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="140" y="400" width="1010" height="66" as="geometry"/></mxCell><mxCell id="prefill-timeline-b29" value="" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="140" y="498" width="1010" height="66" as="geometry"/></mxCell><mxCell id="prefill-timeline-t30" value="один раз на эпоху, до первой копии: инвалидация обоих буферов на потоке вычислений" style="text;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#1f6f8b;html=1;" vertex="1" parent="1"><mxGeometry x="150" y="381" width="488" height="19" as="geometry"/></mxCell><mxCell id="prefill-timeline-b31" value="&lt;b&gt;GEMM L−1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="150" y="406" width="90" height="54" as="geometry"/></mxCell><mxCell id="prefill-timeline-b32" value="&lt;b&gt;GEMM L&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="240" y="406" width="90" height="54" as="geometry"/></mxCell><mxCell id="prefill-timeline-x33" value="ждёт ready" style="rounded=1;dashed=1;whiteSpace=wrap;fontSize=11;fillColor=none;strokeColor=#b3402f;fontColor=#b3402f;html=1;" vertex="1" parent="1"><mxGeometry x="330" y="406" width="100" height="54" as="geometry"/></mxCell><mxCell id="prefill-timeline-b34" value="&lt;b&gt;GEMM L+1&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="430" y="406" width="90" height="54" as="geometry"/></mxCell><mxCell id="prefill-timeline-x35" value="ждёт ready" style="rounded=1;dashed=1;whiteSpace=wrap;fontSize=11;fillColor=none;strokeColor=#b3402f;fontColor=#b3402f;html=1;" vertex="1" parent="1"><mxGeometry x="520" y="406" width="100" height="54" as="geometry"/></mxCell><mxCell id="prefill-timeline-b36" value="&lt;b&gt;GEMM L+2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="620" y="406" width="90" height="54" as="geometry"/></mxCell><mxCell id="prefill-timeline-b37" value="&lt;b&gt;DMA слоя L+1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;≈ 456 МБ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fff5e0;strokeColor=#b7791f;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="240" y="504" width="190" height="54" as="geometry"/></mxCell><mxCell id="prefill-timeline-b38" value="&lt;b&gt;DMA слоя L+2&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fff5e0;strokeColor=#b7791f;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="430" y="504" width="190" height="54" as="geometry"/></mxCell><mxCell id="prefill-timeline-b39" value="&lt;b&gt;DMA слоя L+3&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fff5e0;strokeColor=#b7791f;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="620" y="504" width="190" height="54" as="geometry"/></mxCell><mxCell id="prefill-timeline-t42" value="период слоя = max(счёт, копия)" style="text;fontSize=12;align=right;verticalAlign=middle;spacing=0;fontStyle=1;fontColor=#1d7a46;html=1;" vertex="1" parent="1"><mxGeometry x="932" y="572" width="214" height="20" as="geometry"/></mxCell><mxCell id="prefill-timeline-t43" value="копии идут подряд," style="text;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#1d7a46;html=1;" vertex="1" parent="1"><mxGeometry x="840" y="514.5" width="118" height="19.5" as="geometry"/></mxCell><mxCell id="prefill-timeline-t44" value="PCIe не простаивает" style="text;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#1d7a46;html=1;" vertex="1" parent="1"><mxGeometry x="840" y="530.5" width="132" height="19.5" as="geometry"/></mxCell><mxCell id="prefill-timeline-b46" value="&lt;b&gt;Двойной буфер&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;буфер 0 — слои 0, 2, 4, …; буфер 1 — слои 1, 3, 5, … Копия слоя L+1 пишет в буфер, который прочитал слой L−1: ей ждать нужно только release после GEMM слоя L−1.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="644" width="270" height="130" as="geometry"/></mxCell><mxCell id="prefill-timeline-b47" value="&lt;b&gt;Причина задержки&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;перед DMA на потоке копирования шли 6 мелких ядер инвалидации карты слотов. Им нужны SM, а GEMM слоя L занимает GPU; DMA стоит за ними в том же потоке.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fbe9e7;strokeColor=#b3402f;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="318" y="644" width="270" height="130" as="geometry"/></mxCell><mxCell id="prefill-timeline-b48" value="&lt;b&gt;Что сделали&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;поток копирования получил высший приоритет (−1); оба буфера инвалидируются один раз на эпоху на потоке вычислений, в потоке копирования остаётся чистый DMA.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="600" y="644" width="270" height="130" as="geometry"/></mxCell><mxCell id="prefill-timeline-b49" value="&lt;b&gt;Эффект в лесенке&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;TTFT 64 токена 0.270 → 0.252 с, 2K 0.419 → 0.383 с. На 16K и 120K копия и так спрятана за счётом слоя, TTFT не меняется.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e5f3ea;strokeColor=#1d7a46;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="882" y="644" width="262" height="130" as="geometry"/></mxCell><mxCell id="prefill-timeline-a20" value="release" style="endArrow=block;html=1;rounded=0;strokeColor=#6b46c1;strokeWidth=1.3;dashed=1;dashPattern=2 4;fontSize=10;fontColor=#6b46c1;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="240" y="202" as="sourcePoint"/><mxPoint x="240" y="246" as="targetPoint"/></mxGeometry></mxCell><mxCell id="prefill-timeline-a21" value="ready" style="endArrow=block;html=1;rounded=0;strokeColor=#6b46c1;strokeWidth=1.3;dashed=1;dashPattern=2 4;fontSize=10;fontColor=#6b46c1;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="246" as="sourcePoint"/><mxPoint x="520" y="202" as="targetPoint"/></mxGeometry></mxCell><mxCell id="prefill-timeline-a40" value="release" style="endArrow=block;html=1;rounded=0;strokeColor=#6b46c1;strokeWidth=1.3;dashed=1;dashPattern=2 4;fontSize=10;fontColor=#6b46c1;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="240" y="460" as="sourcePoint"/><mxPoint x="240" y="504" as="targetPoint"/></mxGeometry></mxCell><mxCell id="prefill-timeline-a41" value="ready" style="endArrow=block;html=1;rounded=0;strokeColor=#6b46c1;strokeWidth=1.3;dashed=1;dashPattern=2 4;fontSize=10;fontColor=#6b46c1;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="430" y="504" as="sourcePoint"/><mxPoint x="430" y="460" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="gdn-prefill" name="GDN в prefill: четыре ядра Triton → одно CUDA-ядро по чанкам"><mxGraphModel dx="1180" dy="972" grid="1" gridSize="10" page="1" pageWidth="1180" pageHeight="972" background="#f6f7f9"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="gdn-prefill-title" value="&lt;b&gt;GDN в prefill: четыре ядра Triton → одно CUDA-ядро по чанкам&lt;/b&gt;" style="text;fontSize=18;align=left;verticalAlign=middle;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1140" height="30" as="geometry"/></mxCell><mxCell id="gdn-prefill-sub" value="Слой Gated DeltaNet: 32 головы значений, 16 голов ключей, размер головы 128, чанк 64 токена. Ядра conv + L2, gate + cumsum и gated norm + FP8 остались как в f1, kkt_solve остался на Triton." style="text;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1140" height="34" as="geometry"/></mxCell><mxCell id="gdn-prefill-g1" value="&lt;b&gt;Было: цепочка FLA на Triton, промежуточные тензоры проходят через память&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="1140" height="214" as="geometry"/></mxCell><mxCell id="gdn-prefill-g19" value="&lt;b&gt;Стало (вариант wu): kkt_solve и одно слитое CUDA-ядро&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="318" width="1140" height="168" as="geometry"/></mxCell><mxCell id="gdn-prefill-g26" value="&lt;b&gt;Внутри одного CTA: он идёт по чанкам своей последовательности подряд, по 64 токена&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="500" width="1140" height="458" as="geometry"/></mxCell><mxCell id="gdn-prefill-b2" value="&lt;b&gt;kkt_solve&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;fontSize=13;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="126" width="190" height="56" as="geometry"/></mxCell><mxCell id="gdn-prefill-b3" value="&lt;font style=&quot;font-size:11px&quot;&gt;пишет A_wy [T, 32, 64] bf16&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="206" width="190" height="82" as="geometry"/></mxCell><mxCell id="gdn-prefill-b5" value="&lt;b&gt;recompute_w_u&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;fontSize=13;fillColor=#fbe9e7;strokeColor=#b3402f;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="262" y="126" width="190" height="56" as="geometry"/></mxCell><mxCell id="gdn-prefill-b6" value="&lt;font style=&quot;font-size:11px&quot;&gt;читает A_wy, k, v; пишет w и u [T, 32, 128] bf16&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="262" y="206" width="190" height="82" as="geometry"/></mxCell><mxCell id="gdn-prefill-b8" value="&lt;b&gt;chunk_h&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;fontSize=13;fillColor=#fbe9e7;strokeColor=#b3402f;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="488" y="126" width="190" height="56" as="geometry"/></mxCell><mxCell id="gdn-prefill-b9" value="&lt;font style=&quot;font-size:11px&quot;&gt;читает k, w, u; пишет h (bf16 на каждый чанк) и v_new&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="488" y="206" width="190" height="82" as="geometry"/></mxCell><mxCell id="gdn-prefill-b11" value="&lt;b&gt;chunk_o&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;fontSize=13;fillColor=#fbe9e7;strokeColor=#b3402f;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="714" y="126" width="190" height="56" as="geometry"/></mxCell><mxCell id="gdn-prefill-b12" value="&lt;font style=&quot;font-size:11px&quot;&gt;читает q, k, v_new, h; пишет o [T, 32, 128]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="714" y="206" width="190" height="82" as="geometry"/></mxCell><mxCell id="gdn-prefill-b17" value="&lt;b&gt;Итог&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;4 запуска; w, u, h и v_new пишутся в память и читаются обратно&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="940" y="126" width="204" height="162" as="geometry"/></mxCell><mxCell id="gdn-prefill-b20" value="&lt;b&gt;kkt_solve&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Triton, без изменений&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=13;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="354" width="190" height="56" as="geometry"/></mxCell><mxCell id="gdn-prefill-b21" value="&lt;b&gt;chunk_wu_ho_fused: recompute_w_u + chunk_h + chunk_o&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;сетка (2 блока V по 64, 32 головы, N последовательностей), 128 потоков (4 варпа), shared 99 328 Б&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=13;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="262" y="354" width="628" height="56" as="geometry"/></mxCell><mxCell id="gdn-prefill-b23" value="&lt;font style=&quot;font-size:11px&quot;&gt;читает q, k, v, A_wy, β, g; пишет только o и итоговое состояние H в пул состояний; w, u, h и v_new в глобальную память не попадают&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="262" y="420" width="628" height="54" as="geometry"/></mxCell><mxCell id="gdn-prefill-b24" value="&lt;b&gt;Итог&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;2 запуска вместо 4; результат побитово равен цепочке Triton (teacher 125/125 на ступени)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e5f3ea;strokeColor=#1d7a46;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="940" y="354" width="204" height="120" as="geometry"/></mxCell><mxCell id="gdn-prefill-b27" value="&lt;b&gt;Регистры: состояние H (fp32)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;варп w держит строки V [16w, 16w + 16) × K = 128: 64 регистра на поток, H^T лежит как аккумуляторы MMA; читается из пула один раз и пишется в конце&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e5f3ea;strokeColor=#1d7a46;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="536" width="340" height="112" as="geometry"/></mxCell><mxCell id="gdn-prefill-b28" value="&lt;b&gt;Shared, ≈ 97 КиБ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;w [64 × 128] (он же буфер для o); q [64 × 128]; k ×2; A_wy ×2; v [64 × 64]; Ag [64 × 64]; g и β ×2. k, A_wy, g, β — двойная буферизация cp.async; q и v — одинарная, перезаливаются сразу после использования.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="660" width="340" height="142" as="geometry"/></mxCell><mxCell id="gdn-prefill-b29" value="&lt;b&gt;Условия применения&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;головы 16/32/128, T &amp;gt; 32, FP32-пул состояний; иначе остаётся Triton. Пустая последовательность в батче отправляет батч на старый путь.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="814" width="340" height="128" as="geometry"/></mxCell><mxCell id="gdn-prefill-b30" value="&lt;b&gt;Фаза 0&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;w = A_wy · (k · β · e^g): цепочка MMA по 64 токенам, округление в bf16, w остаётся в shared&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;fontColor=#17202b;align=left;spacingLeft=6;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="536" width="744" height="58" as="geometry"/></mxCell><mxCell id="gdn-prefill-b31" value="&lt;b&gt;Фаза 1&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Ag = маска и затухание от q · kᵀ; v_dot = Hb · wᵀ и qh = Hb · qᵀ по K = 128, где Hb = bf16(H)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;fontColor=#17202b;align=left;spacingLeft=6;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="602" width="744" height="58" as="geometry"/></mxCell><mxCell id="gdn-prefill-b33" value="&lt;b&gt;Фаза 2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;u = A_wy · (v · β); vn = u − v_dot; v_new = bf16(vn); vs = bf16(vn · e^(g_last − g))&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;fontColor=#17202b;align=left;spacingLeft=6;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="668" width="744" height="58" as="geometry"/></mxCell><mxCell id="gdn-prefill-b35" value="&lt;b&gt;Фаза 3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;o = bf16(fma(scale, qh · e^g, scale · (Ag · v_new))) → shared → запись; D = kᵀ · vs; H = fma(H, e^g_last, D)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;fontColor=#17202b;align=left;spacingLeft=6;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="734" width="744" height="58" as="geometry"/></mxCell><mxCell id="gdn-prefill-b38" value="&lt;b&gt;Следующий чанк&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;q, v и k / A_wy / g / β уже загружены cp.async; H остался в регистрах&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;align=left;spacingLeft=6;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="800" width="744" height="48" as="geometry"/></mxCell><mxCell id="gdn-prefill-b39" value="&lt;b&gt;Что это дало&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;GDN в prefill 16K: 67 → 51 мс (Nsight Systems); TTFT 16K 1.343 → 1.316 с (−2 %). Порядок операций в чанке не меняется: каждый выход видит те же наборы K и ту же цепочку, что в Triton.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e5f3ea;strokeColor=#1d7a46;strokeWidth=2;fontColor=#17202b;align=left;spacingLeft=6;html=1;" vertex="1" parent="1"><mxGeometry x="400" y="862" width="744" height="90" as="geometry"/></mxCell><mxCell id="gdn-prefill-a4" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#b7791f;strokeWidth=1.7;dashed=1;fontSize=10;fontColor=#b7791f;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="131" y="182" as="sourcePoint"/><mxPoint x="131" y="206" as="targetPoint"/></mxGeometry></mxCell><mxCell id="gdn-prefill-a7" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#b7791f;strokeWidth=1.7;dashed=1;fontSize=10;fontColor=#b7791f;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="357" y="182" as="sourcePoint"/><mxPoint x="357" y="206" as="targetPoint"/></mxGeometry></mxCell><mxCell id="gdn-prefill-a10" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#b7791f;strokeWidth=1.7;dashed=1;fontSize=10;fontColor=#b7791f;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="583" y="182" as="sourcePoint"/><mxPoint x="583" y="206" as="targetPoint"/></mxGeometry></mxCell><mxCell id="gdn-prefill-a13" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#b7791f;strokeWidth=1.7;dashed=1;fontSize=10;fontColor=#b7791f;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="809" y="182" as="sourcePoint"/><mxPoint x="809" y="206" as="targetPoint"/></mxGeometry></mxCell><mxCell id="gdn-prefill-a14" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="226" y="154" as="sourcePoint"/><mxPoint x="262" y="154" as="targetPoint"/></mxGeometry></mxCell><mxCell id="gdn-prefill-a15" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="452" y="154" as="sourcePoint"/><mxPoint x="488" y="154" as="targetPoint"/></mxGeometry></mxCell><mxCell id="gdn-prefill-a16" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="678" y="154" as="sourcePoint"/><mxPoint x="714" y="154" as="targetPoint"/></mxGeometry></mxCell><mxCell id="gdn-prefill-a18" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="904" y="154" as="sourcePoint"/><mxPoint x="940" y="154" as="targetPoint"/></mxGeometry></mxCell><mxCell id="gdn-prefill-a22" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="226" y="382" as="sourcePoint"/><mxPoint x="262" y="382" as="targetPoint"/></mxGeometry></mxCell><mxCell id="gdn-prefill-a25" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="890" y="382" as="sourcePoint"/><mxPoint x="940" y="382" as="targetPoint"/></mxGeometry></mxCell><mxCell id="gdn-prefill-a32" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.3;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="772" y="594" as="sourcePoint"/><mxPoint x="772" y="602" as="targetPoint"/></mxGeometry></mxCell><mxCell id="gdn-prefill-a34" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.3;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="772" y="660" as="sourcePoint"/><mxPoint x="772" y="668" as="targetPoint"/></mxGeometry></mxCell><mxCell id="gdn-prefill-a36" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.3;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="772" y="726" as="sourcePoint"/><mxPoint x="772" y="734" as="targetPoint"/></mxGeometry></mxCell><mxCell id="gdn-prefill-a37" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.3;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="772" y="792" as="sourcePoint"/><mxPoint x="772" y="800" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="embed-budget" name="Эмбеддинги в pinned RAM и бюджет VRAM: откуда берутся лишние слоты экспертов"><mxGraphModel dx="1180" dy="612" grid="1" gridSize="10" page="1" pageWidth="1180" pageHeight="612" background="#f6f7f9"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="embed-budget-title" value="&lt;b&gt;Эмбеддинги в pinned RAM и бюджет VRAM: откуда берутся лишние слоты экспертов&lt;/b&gt;" style="text;fontSize=18;align=left;verticalAlign=middle;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1140" height="30" as="geometry"/></mxCell><mxCell id="embed-budget-sub" value="Таблица эмбеддингов 248 320 × 2048 bf16 весит 0.95 ГиБ. Пока она в VRAM, эти байты вычитаются из бюджета слотов." style="text;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1140" height="34" as="geometry"/></mxCell><mxCell id="embed-budget-g1" value="&lt;b&gt;Строка эмбеддинга читается прямо из RAM&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="82" width="560" height="330" as="geometry"/></mxCell><mxCell id="embed-budget-g12" value="&lt;b&gt;Бюджет VRAM → число слотов экспертов&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="600" y="82" width="560" height="330" as="geometry"/></mxCell><mxCell id="embed-budget-g27" value="&lt;b&gt;Что это дало (лесенка)&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="426" width="1140" height="160" as="geometry"/></mxCell><mxCell id="embed-budget-b2" value="&lt;b&gt;ids токенов&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;int в VRAM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="118" width="160" height="58" as="geometry"/></mxCell><mxCell id="embed-budget-b3" value="&lt;b&gt;Triton host_gather_rows&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;одна программа на токен, 4 варпа&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="228" y="118" width="330" height="58" as="geometry"/></mxCell><mxCell id="embed-budget-b5" value="&lt;b&gt;Таблица эмбеддингов в pinned RAM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;248 320 × 2048 bf16 = 0.95 ГиБ, отображена в адресное пространство GPU&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="214" width="260" height="84" as="geometry"/></mxCell><mxCell id="embed-budget-b6" value="&lt;b&gt;Строки в VRAM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;4096 Б на токен, байт в байт: целыми 8-байтными словами, без float&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e5f3ea;strokeColor=#1d7a46;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="328" y="214" width="230" height="84" as="geometry"/></mxCell><mxCell id="embed-budget-t8" value="по PCIe: 4096 Б на строку" style="text;fontSize=10;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#b7791f;html=1;" vertex="1" parent="1"><mxGeometry x="272" y="187.5" width="148" height="18.5" as="geometry"/></mxCell><mxCell id="embed-budget-t10" value="Идентификатор вне таблицы даёт нули. Если lm_head читает ту же таблицу (tied)," style="text;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="314.0" width="483" height="19.5" as="geometry"/></mxCell><mxCell id="embed-budget-t11" value="перенос в RAM отклоняется: такая таблица нужна на GPU на каждом шаге." style="text;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="329.5" width="448" height="19.5" as="geometry"/></mxCell><mxCell id="embed-budget-b13" value="&lt;b&gt;пул = memory_ratio × свободная VRAM до модели − веса − фиксированный кэш&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;остаток (1 − memory_ratio) — запас под CUDA-графы и активации; эксперты берут пул первыми (после резерва KV), KV получает остаток&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="616" y="118" width="528" height="84" as="geometry"/></mxCell><mxCell id="embed-budget-t14" value="итого 4611 слотов" style="text;fontSize=11;align=right;verticalAlign=middle;spacing=0;fontStyle=1;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="1021" y="210.5" width="123" height="19.5" as="geometry"/></mxCell><mxCell id="embed-budget-c15" value="f1: 3164 слота" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="616" y="232" width="351.3268271524615" height="40" as="geometry"/></mxCell><mxCell id="embed-budget-c16" value="" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="967.3268271524614" y="232" width="62.73693342008241" height="40" as="geometry"/></mxCell><mxCell id="embed-budget-c17" value="+882" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e5f3ea;strokeColor=#1d7a46;strokeWidth=2;fontColor=#17202b;spacing=0;html=1;" vertex="1" parent="1"><mxGeometry x="1030.063760572544" y="232" width="97.93623942745607" height="40" as="geometry"/></mxCell><mxCell id="embed-budget-t20" value="+565 слотов: таблица эмбеддингов ушла в RAM," style="text;fontSize=11;align=right;verticalAlign=middle;spacing=0;fontStyle=1;fontColor=#1f6f8b;html=1;" vertex="1" parent="1"><mxGeometry x="653" y="284.0" width="305" height="19.5" as="geometry"/></mxCell><mxCell id="embed-budget-t21" value="освободилось 0.95 ГиБ" style="text;fontSize=11;align=right;verticalAlign=middle;spacing=0;fontStyle=1;fontColor=#1f6f8b;html=1;" vertex="1" parent="1"><mxGeometry x="806" y="299.5" width="152" height="19.5" as="geometry"/></mxCell><mxCell id="embed-budget-t22" value="memory_ratio" style="text;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fontColor=#1d7a46;html=1;" vertex="1" parent="1"><mxGeometry x="1038.1" y="278.0" width="97" height="19.5" as="geometry"/></mxCell><mxCell id="embed-budget-t23" value="0.75 → 0.85" style="text;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fontColor=#1d7a46;html=1;" vertex="1" parent="1"><mxGeometry x="1038.1" y="293.5" width="75" height="19.5" as="geometry"/></mxCell><mxCell id="embed-budget-t24" value="В main128 слотов 4603: самопроверки ядер при финализации весов оставляют ≈ 14 МиБ в кэше" style="text;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="616" y="344.0" width="536" height="19" as="geometry"/></mxCell><mxCell id="embed-budget-t25" value="аллокатора, и бюджет засчитывает их как веса. Плотные веса FP8 и attention ≈ 1.57 ГиБ," style="text;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="616" y="358.9" width="515" height="19" as="geometry"/></mxCell><mxCell id="embed-budget-t26" value="KV-кэш на 128K ≈ 2.5 ГиБ." style="text;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="616" y="373.7" width="154" height="19" as="geometry"/></mxCell><mxCell id="embed-budget-b28" value="&lt;b&gt;Промахи кэша на токен, 16K&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;27.7 → 19.9 → 12.3 при слотах 3164 → 3729 → 4611&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e5f3ea;strokeColor=#1d7a46;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="462" width="270" height="108" as="geometry"/></mxCell><mxCell id="embed-budget-b29" value="&lt;b&gt;Эмбеддинги в RAM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;декод 16K +5.2 ток/с (148.6 → 153.8); TTFT в пределах шума&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="318" y="462" width="270" height="108" as="geometry"/></mxCell><mxCell id="embed-budget-b30" value="&lt;b&gt;memory_ratio 0.85&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;декод 16K +5.7 ток/с (153.8 → 159.5); TTFT 64 токена 0.314 → 0.259 с&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="600" y="462" width="270" height="108" as="geometry"/></mxCell><mxCell id="embed-budget-b31" value="&lt;b&gt;Windows не подкачивает&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;за 2-часовой soak shared-память Windows выросла на 30 МиБ&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="882" y="462" width="262" height="108" as="geometry"/></mxCell><mxCell id="embed-budget-a4" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="196" y="147" as="sourcePoint"/><mxPoint x="228" y="147" as="targetPoint"/></mxGeometry></mxCell><mxCell id="embed-budget-a7" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#b7791f;strokeWidth=1.7;dashed=1;fontSize=10;fontColor=#b7791f;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="262" y="214" as="sourcePoint"/><mxPoint x="262" y="176" as="targetPoint"/></mxGeometry></mxCell><mxCell id="embed-budget-a9" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="443" y="176" as="sourcePoint"/><mxPoint x="443" y="214" as="targetPoint"/></mxGeometry></mxCell><mxCell id="embed-budget-a18" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.2;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="969.3268271524614" y="272" as="sourcePoint"/><mxPoint x="969.3268271524614" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="embed-budget-a19" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.2;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1032.063760572544" y="272" as="sourcePoint"/><mxPoint x="1032.063760572544" y="292" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
