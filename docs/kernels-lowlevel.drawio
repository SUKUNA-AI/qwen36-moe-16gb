<mxfile host="tools/kernels-diagram.py"><diagram id="decode-layer" name="Шаг decode одного MoE-слоя по потокам: было (f1) и стало (main128)"><mxGraphModel dx="1180" dy="810" grid="1" gridSize="10" page="1" pageWidth="1180" pageHeight="810" background="#f6f7f9"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="decode-layer-title" value="&lt;b&gt;Шаг decode одного MoE-слоя по потокам: было (f1) и стало (main128)&lt;/b&gt;" style="text;fontSize=18;align=left;verticalAlign=middle;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1140" height="30" as="geometry"/></mxCell><mxCell id="decode-layer-sub" value="Один токен, один из 40 MoE-слоёв. Ширина блоков условная: схема показывает порядок и перекрытие, а не длительности. Весь шаг decode записан в один CUDA-граф, вилка и соединение потоков становятся рёбрами графа." style="text;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1140" height="34" as="geometry"/></mxCell><mxCell id="decode-layer-g1" value="&lt;b&gt;Было (f1): всё на одном потоке, подряд&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="98" width="1140" height="188" as="geometry"/></mxCell><mxCell id="decode-layer-g19" value="&lt;b&gt;Стало (main128): подкачка идёт на побочном потоке, пока считается shared-эксперт&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="1140" height="352" as="geometry"/></mxCell><mxCell id="decode-layer-g45" value="&lt;b&gt;Что внутри routed: какие ядра наши, какие без изменений&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="664" width="1140" height="132" as="geometry"/></mxCell><mxCell id="decode-layer-t2" value="основной" style="text;fontSize=12;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="34" y="154" width="69" height="20" as="geometry"/></mxCell><mxCell id="decode-layer-t3" value="поток" style="text;fontSize=12;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="34" y="170" width="46" height="20" as="geometry"/></mxCell><mxCell id="decode-layer-b4" value="&lt;b&gt;Роутер&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;gate bf16 → softmax, top-8&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="150" y="128" width="100" height="92" as="geometry"/></mxCell><mxCell id="decode-layer-b5" value="&lt;b&gt;Shared-эксперт&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;gate_up → SiLU·mul → down; линейка σ-гейта&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="264" y="128" width="160" height="92" as="geometry"/></mxCell><mxCell id="decode-layer-b6" value="&lt;b&gt;ensure_experts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;LRU: попадание или слот вытеснения&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="438" y="128" width="120" height="92" as="geometry"/></mxCell><mxCell id="decode-layer-b7" value="&lt;b&gt;Подкачка промахов&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ядро копирования: pinned RAM → слоты VRAM, ждёт PCIe&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fff5e0;strokeColor=#b7791f;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="572" y="128" width="180" height="92" as="geometry"/></mxCell><mxCell id="decode-layer-b8" value="&lt;b&gt;Routed-эксперты&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Triton: gate_up → SiLU·mul → down → Σ по top-8&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="766" y="128" width="220" height="92" as="geometry"/></mxCell><mxCell id="decode-layer-b9" value="&lt;b&gt;Эпилог&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;3 мелких bf16-ядра: σ(gate), shared·σ, routed + prod&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fbe9e7;strokeColor=#b3402f;strokeWidth=1.6;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="1000" y="128" width="150" height="92" as="geometry"/></mxCell><mxCell id="decode-layer-t16" value="время →" style="text;fontSize=11;align=right;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="1096" y="244.5" width="54" height="19.5" as="geometry"/></mxCell><mxCell id="decode-layer-t18" value="shared, затем подкачка: время слоя = сумма" style="text;fontSize=11;align=center;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#b3402f;html=1;" vertex="1" parent="1"><mxGeometry x="376.0" y="244.5" width="264" height="19.5" as="geometry"/></mxCell><mxCell id="decode-layer-b20" value="" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="142" y="326" width="1008" height="108" as="geometry"/></mxCell><mxCell id="decode-layer-b21" value="" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="142" y="444" width="1008" height="84" as="geometry"/></mxCell><mxCell id="decode-layer-b22" value="" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#f1f3f6;strokeColor=#b5bfcb;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="142" y="538" width="1008" height="44" as="geometry"/></mxCell><mxCell id="decode-layer-t23" value="основной" style="text;fontSize=12;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="34" y="362" width="69" height="20" as="geometry"/></mxCell><mxCell id="decode-layer-t24" value="поток" style="text;fontSize=12;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="34" y="378" width="46" height="20" as="geometry"/></mxCell><mxCell id="decode-layer-t25" value="побочный" style="text;fontSize=12;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="34" y="470" width="73" height="20" as="geometry"/></mxCell><mxCell id="decode-layer-t26" value="поток" style="text;fontSize=12;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="34" y="486" width="46" height="20" as="geometry"/></mxCell><mxCell id="decode-layer-t27" value="канал PCIe" style="text;fontSize=12;align=left;verticalAlign=middle;spacing=0;fontStyle=1;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="34" y="550" width="83" height="20" as="geometry"/></mxCell><mxCell id="decode-layer-b28" value="&lt;b&gt;Роутер&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;gate bf16 → softmax, top-8&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="152" y="336" width="100" height="88" as="geometry"/></mxCell><mxCell id="decode-layer-b29" value="&lt;b&gt;ensure_experts&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;LRU: слоты для промахов, topk_ids → слоты&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="264" y="336" width="120" height="88" as="geometry"/></mxCell><mxCell id="decode-layer-b30" value="&lt;b&gt;Shared-эксперт&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;gate_up → SiLU·mul → down и линейка σ-гейта: считается, пока идёт подкачка&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="414" y="336" width="290" height="88" as="geometry"/></mxCell><mxCell id="decode-layer-b31" value="&lt;b&gt;Routed: наше CUDA-ядро MoE&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;gate_up → SiLU·mul → down (× вес роутера) → Σ по top-8&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="744" y="336" width="244" height="88" as="geometry"/></mxCell><mxCell id="decode-layer-b32" value="&lt;b&gt;Слитый эпилог&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;σ(gate)·shared + routed одним ядром&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="998" y="336" width="142" height="88" as="geometry"/></mxCell><mxCell id="decode-layer-b37" value="&lt;b&gt;Подкачка промахов (TMA-ядро)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;cp.async.bulk: 8 CTA × 3 стадии × 16 КиБ, pinned RAM → слоты&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#fff5e0;strokeColor=#b7791f;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="414" y="452" width="290" height="68" as="geometry"/></mxCell><mxCell id="decode-layer-b38" value="&lt;b&gt;PCIe ≈ 42–49 ГБ/с: RAM → слоты VRAM&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;fontSize=11;fillColor=#fff5e0;strokeColor=#b7791f;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="414" y="546" width="290" height="28" as="geometry"/></mxCell><mxCell id="decode-layer-t42" value="До соединения потоков слой ждёт max(shared, подкачка), а не их сумму. Если промахов нет, ядро подкачки выходит сразу: число промахов читается на устройстве," style="text;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="150" y="590.0" width="962" height="19.5" as="geometry"/></mxCell><mxCell id="decode-layer-t43" value="форма запуска фиксирована." style="text;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="150" y="605.5" width="173" height="19.5" as="geometry"/></mxCell><mxCell id="decode-layer-t44" value="пунктир с «ready» и «done» — события между потоками" style="text;fontSize=11;align=right;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#6b46c1;html=1;" vertex="1" parent="1"><mxGeometry x="821" y="309" width="319" height="19" as="geometry"/></mxCell><mxCell id="decode-layer-b46" value="&lt;b&gt;gate_up GEMV (наше ядро)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;N = 1024, K = 2048, NVFP4 → bf16 [8 × 1024]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="696" width="250" height="56" as="geometry"/></mxCell><mxCell id="decode-layer-b47" value="&lt;b&gt;SiLU·mul&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ядро Triton, без изменений&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="312" y="696" width="250" height="56" as="geometry"/></mxCell><mxCell id="decode-layer-b48" value="&lt;b&gt;down GEMV (наше ядро)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;N = 2048, K = 512, × вес роутера → [8 × 2048]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#e3f0f5;strokeColor=#1f6f8b;strokeWidth=2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="588" y="696" width="250" height="56" as="geometry"/></mxCell><mxCell id="decode-layer-b49" value="&lt;b&gt;Σ по top-8&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ядро Triton, без изменений&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;fontSize=12;fillColor=#ffffff;strokeColor=#9aa6b4;strokeWidth=1.2;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="864" y="696" width="250" height="56" as="geometry"/></mxCell><mxCell id="decode-layer-t53" value="Nsight Systems, 16K (под профайлером): подкачка 1.08 → 0.64 мс из 7.07 → 5.78 мс на шаг decode; эпилог: −2 запуска на слой, −80 на шаг." style="text;fontSize=11;align=left;verticalAlign=middle;spacing=0;fontStyle=0;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="36" y="766.5" width="797" height="19.5" as="geometry"/></mxCell><mxCell id="decode-layer-a10" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="250" y="174" as="sourcePoint"/><mxPoint x="264" y="174" as="targetPoint"/></mxGeometry></mxCell><mxCell id="decode-layer-a11" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="424" y="174" as="sourcePoint"/><mxPoint x="438" y="174" as="targetPoint"/></mxGeometry></mxCell><mxCell id="decode-layer-a12" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="558" y="174" as="sourcePoint"/><mxPoint x="572" y="174" as="targetPoint"/></mxGeometry></mxCell><mxCell id="decode-layer-a13" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="752" y="174" as="sourcePoint"/><mxPoint x="766" y="174" as="targetPoint"/></mxGeometry></mxCell><mxCell id="decode-layer-a14" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="986" y="174" as="sourcePoint"/><mxPoint x="1000" y="174" as="targetPoint"/></mxGeometry></mxCell><mxCell id="decode-layer-a15" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.2;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="240" as="sourcePoint"/><mxPoint x="1150" y="240" as="targetPoint"/></mxGeometry></mxCell><mxCell id="decode-layer-a17" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#b3402f;strokeWidth=2;fontSize=10;fontColor=#b3402f;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="264" y="232" as="sourcePoint"/><mxPoint x="752" y="232" as="targetPoint"/></mxGeometry></mxCell><mxCell id="decode-layer-a33" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeomet