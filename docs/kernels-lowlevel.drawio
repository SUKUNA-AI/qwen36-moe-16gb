try></mxCell><mxCell id="decode-layer-a41" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#b7791f;strokeWidth=1.7;dashed=1;fontSize=10;fontColor=#b7791f;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="559" y="520" as="sourcePoint"/><mxPoint x="559" y="546" as="targetPoint"/></mxGeometry></mxCell><mxCell id="decode-layer-a50" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="286" y="724" as="sourcePoint"/><mxPoint x="312" y="724" as="targetPoint"/></mxGeometry></mxCell><mxCell id="decode-layer-a51" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="562" y="724" as="sourcePoint"/><mxPoint x="588" y="724" as="targetPoint"/></mxGeometry></mxCell><mxCell id="decode-layer-a52" value="" style="endArrow=block;html=1;rounded=0;strokeColor=#7d8a99;strokeWidth=1.7;fontSize=10;fontColor=#7d8a99;labelBackgroundColor=#f6f7f9;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="838" y="724" as="sourcePoint"/><mxPoint x="864" y="724" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="oproj" name="o-проекция в decode: split-K = 3 у cuBLASLt и наше ядро в один запуск"><mxGraphModel dx="1180" dy="960" grid="1" gridSize="10" page="1" pageWidth="1180" pageHeight="960" background="#f6f7f9"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="oproj-title" value="&lt;b&gt;o-проекция в decode: split-K = 3 у cuBLASLt и наше ядро в один запуск&lt;/b&gt;" style="text;fontSize=18;align=left;verticalAlign=middle;fontColor=#17202b;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1140" height="30" as="geometry"/></mxCell><mxCell id="oproj-sub" value="Y[M, 2048] = bf16((X[M, 4096] · W[2048, 4096]ᵀ) · sa · sb) в FP8 e4m3, M = 1…8. 40 таких проекций на шаг: 30 out_proj слоёв GDN и 10 o_proj слоёв attention." style="text;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1140" height="34" as="geometry"/></mxCell><mxCell id="oproj-g1" value="&lt;b&gt;K = 4096 байт строки = 64 тайла по 64 байта; тайл t получает сплит z = t mod 3, по кругу&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="1140" height="124" as="geometry"/></mxCell><mxCell id="oproj-g82" value="&lt;b&gt;Было: memset + GEMM xmma, split-K внутри ядра cuBLASLt&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="20" y="228" width="565" height="566" as="geometry"/></mxCell><mxCell id="oproj-g97" value="&lt;b&gt;Стало: libqwen_oproj_gemv, один запуск без memset и семафора&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="595" y="228" width="565" height="566" as="geometry"/></mxCell><mxCell id="oproj-g99" value="&lt;b&gt;Один CTA: полоса из 16 строк W&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#d3d9e1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=12;fontColor=#5b6675;html=1;" vertex="1" parent="1"><mxGeometry x="611" y="336" width="533" height="258" as="geometry"/></mxCell><mxCell id="oproj-g113" value="&lt;b&gt;Как гарантируется бит-в-бит и что будет при несовпадении&lt;/b&gt;" style="rounded=1;dashed=1;fillColor=#ffffff;strokeColor=#