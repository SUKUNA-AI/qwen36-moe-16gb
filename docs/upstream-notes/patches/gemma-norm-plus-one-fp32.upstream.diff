+            from freetoken.kernel.triton.norm import gemma_fused_add_rmsnorm, gemma_rmsnorm
+        if plus_one:
+            # Zero-centred checkpoint weight (scale - 1, Qwen3.5/3.6): multiply by (1 + w) in fp32
